{% doc %}
  @prompt
    Create a USP point with 3*2 grid. Allow me to change icons, font sizes, wiith headings and subheadings, highly responsive on hover., THere is no heading and subheading of the entire section, remove black dot on hover in thw icon secrtion
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-usp-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-usp-section-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    max-width: 1400px;
    margin: 0 auto {{ block.settings.header_spacing }}px;
  }

  .ai-usp-section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: {{ block.settings.section_title_weight }};
    color: {{ block.settings.section_title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-usp-section-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_subtitle_size }}px;
    font-weight: {{ block.settings.section_subtitle_weight }};
    color: {{ block.settings.section_subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-usp-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-usp-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-usp-item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.item_hover_background }};
    border-color: {{ block.settings.border_hover_color }};
    transform: translateY({{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow_size }}px {{ block.settings.hover_shadow_size | times: 2 }}px rgba(0, 0, 0, {{ block.settings.hover_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-usp-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-usp-item-{{ ai_gen_id }}:hover .ai-usp-icon-wrapper-{{ ai_gen_id }} {
    transform: scale({{ block.settings.icon_hover_scale | divided_by: 100.0 }}) rotate({{ block.settings.icon_hover_rotate }}deg);
  }

  .ai-usp-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: all 0.3s ease;
  }

  .ai-usp-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-usp-icon-placeholder-{{ ai_gen_id }} svg {
    width: 70%;
    height: 70%;
    opacity: 0.3;
  }

  .ai-usp-item-{{ ai_gen_id }}:hover .ai-usp-icon-{{ ai_gen_id }} {
    filter: brightness({{ block.settings.icon_hover_brightness }}%);
  }

  .ai-usp-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-usp-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    transition: color 0.3s ease;
  }

  .ai-usp-item-{{ ai_gen_id }}:hover .ai-usp-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_hover_color }};
  }

  .ai-usp-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    color: {{ block.settings.subheading_color }};
    line-height: 1.5;
    margin: 0;
    transition: color 0.3s ease;
  }

  .ai-usp-item-{{ ai_gen_id }}:hover .ai-usp-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-usp-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-usp-section-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.85 }}px;
    }

    .ai-usp-section-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_subtitle_size | times: 0.9 }}px;
    }

    .ai-usp-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }

    .ai-usp-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .ai-usp-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-usp-grid-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-usp-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 15px;
    }

    .ai-usp-section-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.75 }}px;
    }

    .ai-usp-section-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_subtitle_size | times: 0.85 }}px;
    }

    .ai-usp-item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding | times: 0.8 }}px;
    }

    .ai-usp-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.75 }}px;
      height: {{ block.settings.icon_size | times: 0.75 }}px;
    }

    .ai-usp-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-usp-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-usp-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
    <div class="ai-usp-section-header-{{ ai_gen_id }}">
      {% if block.settings.section_title != blank %}
        <h2 class="ai-usp-section-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      {% endif %}
      
      {% if block.settings.section_subtitle != blank %}
        <p class="ai-usp-section-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-usp-grid-container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign heading_key = 'heading_' | append: i
        assign subheading_key = 'subheading_' | append: i
        assign icon_key = 'icon_' | append: i
        
        assign heading = block.settings[heading_key]
        assign subheading = block.settings[subheading_key]
        assign icon = block.settings[icon_key]
      %}
      
      <div class="ai-usp-item-{{ ai_gen_id }}">
        <div class="ai-usp-icon-wrapper-{{ ai_gen_id }}">
          {% if icon != blank %}
            <img
              src="{{ icon | image_url: width: 200 }}"
              alt="{{ heading | escape }}"
              class="ai-usp-icon-{{ ai_gen_id }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-usp-icon-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        <div class="ai-usp-content-{{ ai_gen_id }}">
          {% if heading != blank %}
            <h3 class="ai-usp-heading-{{ ai_gen_id }}">{{ heading }}</h3>
          {% endif %}
          
          {% if subheading != blank %}
            <p class="ai-usp-subheading-{{ ai_gen_id }}">{{ subheading }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

