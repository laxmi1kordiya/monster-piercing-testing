{% doc %}
  @prompt
    Product badges block - displays trust/info badges below the product form with image icons and text labels.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .product-badges-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    margin-top: {{ block.settings.margin_top }}px;
    background-color: {{ block.settings.background_color }};
    {% if block.settings.border_top %}
      border-top: 1px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .product-badges-grid-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;
    justify-content: {{ block.settings.alignment }};
    gap: {{ block.settings.gap }}px;
  }

  .product-badge-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.icon_text_gap }}px;
    flex: 1 1 0;
    min-width: 0;
  }

  .product-badge-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-badge-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-badge-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.3;
    font-weight: {{ block.settings.text_weight }};
  }

  @media screen and (max-width: 749px) {
    .product-badges-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px 0 {{ block.settings.mobile_padding_bottom }}px;
    }

    .product-badges-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_gap }}px;
      justify-content: center;
    }

    .product-badge-item-{{ ai_gen_id }} {
      min-width: 0;
    }

    .product-badge-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .product-badge-icon-{{ ai_gen_id }} img {
      max-width: 100%;
      height: auto;
    }

    .product-badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }

{% endstyle %}

<div class="product-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="product-badges-grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign icon_key = 'badge_' | append: i | append: '_icon'
        assign text_key = 'badge_' | append: i | append: '_text'
        assign icon = block.settings[icon_key]
        assign text = block.settings[text_key]
      %}

      {% if icon or text != blank %}
        <div class="product-badge-item-{{ ai_gen_id }}">
          {% if icon %}
            <div class="product-badge-icon-{{ ai_gen_id }}">
              <img
                src="{{ icon | image_url: width: 100 }}"
                alt="{{ text | escape }}"
                loading="lazy"
                width="100"
                height="100"
              >
            </div>
          {% endif %}
          {% if text != blank %}
            <div class="product-badge-text-{{ ai_gen_id }}">{{ text }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

