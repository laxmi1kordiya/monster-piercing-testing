{% doc %}
  @prompt
    advertisement bar which contain multiple text inside which slides in the direction we want from left to rigth and right to left it should have the a buton to toggle between both and the frst text should come at the last so it will rotate as the circle like that we can set the texts colour in that and the background colour 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
    position: relative;
    padding: {{ block.settings.bar_padding }}px 0;
  }

  .ai-announcement-bar-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0;
    white-space: nowrap;
  }

  .ai-announcement-bar-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    padding: 0 {{ block.settings.text_spacing }}px;
    display: inline-block;
  }

  .ai-announcement-bar-container-{{ ai_gen_id }}.ai-sliding-{{ ai_gen_id }} {
    animation: ai-slide-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
  }

  .ai-announcement-bar-container-{{ ai_gen_id }}.ai-sliding-reverse-{{ ai_gen_id }} {
    animation: ai-slide-reverse-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
  }

  .ai-announcement-bar-controls-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    right: {{ block.settings.button_position }}px;
    transform: translateY(-50%);
    z-index: 10;
  }

  .ai-announcement-bar-toggle-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    padding: {{ block.settings.button_padding }}px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .ai-announcement-bar-toggle-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-announcement-bar-toggle-{{ ai_gen_id }} svg {
    width: {{ block.settings.button_icon_size }}px;
    height: {{ block.settings.button_icon_size }}px;
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  data-direction="{{ block.settings.initial_direction }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-bar-container-{{ ai_gen_id }} ai-sliding-{{ ai_gen_id }}" data-announce-track="{{ ai_gen_id }}">
    {% assign text_count = 0 %}
    {% if block.settings.text_1 != blank %}{% assign text_count = text_count | plus: 1 %}{% endif %}
    {% if block.settings.text_2 != blank %}{% assign text_count = text_count | plus: 1 %}{% endif %}
    {% if block.settings.text_3 != blank %}{% assign text_count = text_count | plus: 1 %}{% endif %}
    {% if block.settings.text_4 != blank %}{% assign text_count = text_count | plus: 1 %}{% endif %}
    {% if block.settings.text_5 != blank %}{% assign text_count = text_count | plus: 1 %}{% endif %}

    {% for i in (1..3) %}
      {% if block.settings.text_1 != blank %}
        <span class="ai-announcement-bar-text-{{ ai_gen_id }}" {% if i == 1 %}data-set="first"{% endif %}>{{ block.settings.text_1 }}</span>
      {% endif %}
      {% if block.settings.text_2 != blank %}
        <span class="ai-announcement-bar-text-{{ ai_gen_id }}" {% if i == 1 %}data-set="first"{% endif %}>{{ block.settings.text_2 }}</span>
      {% endif %}
      {% if block.settings.text_3 != blank %}
        <span class="ai-announcement-bar-text-{{ ai_gen_id }}" {% if i == 1 %}data-set="first"{% endif %}>{{ block.settings.text_3 }}</span>
      {% endif %}
      {% if block.settings.text_4 != blank %}
        <span class="ai-announcement-bar-text-{{ ai_gen_id }}" {% if i == 1 %}data-set="first"{% endif %}>{{ block.settings.text_4 }}</span>
      {% endif %}
      {% if block.settings.text_5 != blank %}
        <span class="ai-announcement-bar-text-{{ ai_gen_id }}" {% if i == 1 %}data-set="first"{% endif %}>{{ block.settings.text_5 }}</span>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.show_toggle_button %}
    <div class="ai-announcement-bar-controls-{{ ai_gen_id }}">
      <button
        class="ai-announcement-bar-toggle-{{ ai_gen_id }}"
        aria-label="Toggle scroll direction"
      >
        <svg
          class="ai-icon-left-{{ ai_gen_id }}"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <svg
          class="ai-icon-right-{{ ai_gen_id }}"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="display: none;"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {% endif %}
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.container = this.querySelector('.ai-announcement-bar-container-{{ ai_gen_id }}');
        this.toggleButton = this.querySelector('.ai-announcement-bar-toggle-{{ ai_gen_id }}');
        this.iconLeft = this.querySelector('.ai-icon-left-{{ ai_gen_id }}');
        this.iconRight = this.querySelector('.ai-icon-right-{{ ai_gen_id }}');
        this.direction = this.dataset.direction;
        this.styleEl = null;
      }

      connectedCallback() {
        if (this.toggleButton) {
          this.toggleButton.addEventListener('click', () => this.toggleDirection());
        }
        this.createKeyframes();
        this.updateDirection();
      }

      createKeyframes() {
        var firstSetItems = this.container.querySelectorAll('[data-set="first"]');
        if (firstSetItems.length === 0) return;

        var firstItem = firstSetItems[0];
        var lastItem = firstSetItems[firstSetItems.length - 1];
        var setWidth = lastItem.getBoundingClientRect().right - firstItem.getBoundingClientRect().left;

        this.styleEl = document.createElement('style');
        this.styleEl.textContent =
          '@keyframes ai-slide-{{ ai_gen_id }} { from { transform: translateX(0); } to { transform: translateX(-' + setWidth + 'px); } }' +
          '@keyframes ai-slide-reverse-{{ ai_gen_id }} { from { transform: translateX(-' + setWidth + 'px); } to { transform: translateX(0); } }';
        document.head.appendChild(this.styleEl);
      }

      toggleDirection() {
        if (this.direction === 'left') {
          this.direction = 'right';
        } else {
          this.direction = 'left';
        }
        this.updateDirection();
      }

      updateDirection() {
        this.container.classList.remove('ai-sliding-{{ ai_gen_id }}', 'ai-sliding-reverse-{{ ai_gen_id }}');

        void this.container.offsetWidth;

        if (this.direction === 'left') {
          this.container.classList.add('ai-sliding-{{ ai_gen_id }}');
          if (this.iconLeft && this.iconRight) {
            this.iconLeft.style.display = 'block';
            this.iconRight.style.display = 'none';
          }
        } else {
          this.container.classList.add('ai-sliding-reverse-{{ ai_gen_id }}');
          if (this.iconLeft && this.iconRight) {
            this.iconLeft.style.display = 'none';
            this.iconRight.style.display = 'block';
          }
        }
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Sliding announcement bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Announcement texts"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Text 1",
      "default": "Free shipping on orders over £20"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text 2",
      "default": "Shop the latest collection"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text 3",
      "default": "New arrivals every week"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Text 4"
    },
    {
      "type": "text",
      "id": "text_5",
      "label": "Text 5"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "initial_direction",
      "label": "Initial direction",
      "options": [
        {
          "value": "left",
          "label": "Left to right"
        },
        {
          "value": "right",
          "label": "Right to left"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Animation speed",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "s",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "bar_padding",
      "label": "Vertical padding",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Text spacing",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Toggle button"
    },
    {
      "type": "checkbox",
      "id": "show_toggle_button",
      "label": "Show toggle button",
      "default": true
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Button padding",
      "min": 4,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "button_icon_size",
      "label": "Button icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "button_position",
      "label": "Button position from right",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Sliding announcement bar"
    }
  ]
}
{% endschema %}