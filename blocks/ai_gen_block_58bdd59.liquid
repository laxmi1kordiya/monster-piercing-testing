    .ai-hero-slider__slides-{{ ai_gen_id }} {
      aspect-ratio: {{ block.settings.mobile_aspect_ratio }};
    }

    .ai-hero-slider__background-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-slider__background-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-slider__heading-{{ ai_gen_id }} {
      {% if block.settings.use_mobile_heading_size %}
        font-size: {{ block.settings.mobile_heading_size }}px;
        min-height: auto;
      {% else %}
        font-size: {{ block.settings.heading_size | times: 0.5 }}px;
        min-height: auto;
      {% endif %}
      letter-spacing: {{ block.settings.letter_spacing | times: 0.5 }}px;
      {% if block.settings.mobile_text_shadow_style == 'custom' %}
        text-shadow: {{ block.settings.mobile_text_shadow_custom }};
      {% elsif block.settings.mobile_text_shadow_style != 'same_as_desktop' %}
        text-shadow: {{ block.settings.mobile_text_shadow_style }};
