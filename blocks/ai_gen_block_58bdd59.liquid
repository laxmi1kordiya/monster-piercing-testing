<hero-slider-{{ ai_gen_id }}
  class="ai-hero-slider-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.enable_slider }}"
  data-interval="{{ block.settings.slider_interval }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-slider__slides-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
        assign slide_image_key = 'slide_' | append: i | append: '_image'
        assign slide_heading_key = 'slide_' | append: i | append: '_heading'
        assign slide_description_key = 'slide_' | append: i | append: '_description'
        assign slide_button_text_key = 'slide_' | append: i | append: '_button_text'
        assign slide_button_link_key = 'slide_' | append: i | append: '_button_link'
        assign slide_mobile_image_key = 'slide_' | append: i | append: '_mobile_image'

        assign slide_enabled = block.settings[slide_enabled_key]
        assign slide_image = block.settings[slide_image_key]
        assign slide_mobile_image = block.settings[slide_mobile_image_key]
        assign slide_heading = block.settings[slide_heading_key]
        assign slide_description = block.settings[slide_description_key]
        assign slide_button_text = block.settings[slide_button_text_key]
        assign slide_button_link = block.settings[slide_button_link_key]
      %}

      {% if slide_enabled %}
        <div
          class="ai-hero-slider__slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-slide="{{ i }}"
        >
          {% comment %} Desktop Image {% endcomment %}
          {% if slide_image %}
            <img
              src="{{ slide_image | image_url: width: 2000 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="2000"
              height="700"
              class="ai-hero-slider__background-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-hero-slider__placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% comment %} Mobile Image {% endcomment %}
          {% if slide_mobile_image %}
            <img
              src="{{ slide_mobile_image | image_url: width: 1000 }}"
              alt="{{ slide_mobile_image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="750"
              height="1000"
              class="ai-hero-slider__background-mobile-{{ ai_gen_id }}"
            >
          {% elsif slide_image %}
            {% comment %} Fallback to desktop image if no mobile image {% endcomment %}
            <img
              src="{{ slide_image | image_url: width: 1000 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="750"
              height="1000"
              class="ai-hero-slider__background-mobile-{{ ai_gen_id }}"
            >
          {% else %}
            {% comment %} Show placeholder on mobile if no images {% endcomment %}
            <div class="ai-hero-slider__placeholder-mobile-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-hero-slider__overlay-{{ ai_gen_id }}"></div>

          <div class="ai-hero-slider__content-wrapper-{{ ai_gen_id }}">
            <div class="ai-hero-slider__content-{{ ai_gen_id }}">
              {% if slide_heading != blank %}
                <div class="ai-hero-slider__heading-wrapper-{{ ai_gen_id }}">
                  <h1 class="ai-hero-slider__heading-{{ ai_gen_id }}"
                      data-typewriter="{{ block.settings.enable_typewriter }}"
                      data-typing-speed="{{ block.settings.typing_speed }}"
                      data-erasing-speed="{{ block.settings.erasing_speed }}"
                      data-pause-duration="{{ block.settings.pause_duration }}"
                      data-original-text="{{ slide_heading | escape }}">
                    {% if block.settings.enable_typewriter %}
                      <span class="typewriter-text"></span>
                    {% else %}
                      {{ slide_heading | newline_to_br }}
                    {% endif %}
                  </h1>
                </div>
              {% endif %}

              {% if slide_description != blank %}
                <div class="ai-hero-slider__description-{{ ai_gen_id }}">{{ slide_description }}</div>
              {% endif %}

              {% if slide_button_text != blank and block.settings.show_button %}
                <a
                  href="{{ slide_button_link }}"
                  class="ai-hero-slider__button-{{ ai_gen_id }}"
                >
                  {{ slide_button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.enable_slider and block.settings.show_dots %}
    <div class="ai-hero-slider__dots-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign slide_enabled = block.settings[slide_enabled_key]
        %}
        {% if slide_enabled %}
          <button
            class="ai-hero-slider__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-slide="{{ i }}"
            aria-label="Go to slide {{ i }}"
          ></button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</hero-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-hero-slider__slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-hero-slider__dot-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.interval = parseInt(this.dataset.interval) * 1000;

        if (this.slides.length > 1) {
          this.setupEventListeners();
          if (this.autoplay) {
            this.startAutoplay();
          }
        }

        // Initialize typewriter effect after a short delay to ensure fonts are loaded
        setTimeout(() => {
          this.initTypewriter();
        }, 300);
      }

      initTypewriter() {
        const headings = this.querySelectorAll('.ai-hero-slider__heading-{{ ai_gen_id }}');

        headings.forEach(heading => {
          const enableTypewriter = heading.dataset.typewriter === 'true';

          if (enableTypewriter) {
            const originalText = heading.dataset.originalText;
            const typingSpeed = parseInt(heading.dataset.typingSpeed) || 100;
            const erasingSpeed = parseInt(heading.dataset.erasingSpeed) || 50;
            const pauseDuration = parseInt(heading.dataset.pauseDuration) || 2000;
            const textElement = heading.querySelector('.typewriter-text');

            if (textElement && originalText) {
              let charIndex = 0;
              let isTyping = true;

              // Measure and set min-height to prevent layout shift
              const setMinHeight = () => {
                const currentContent = textElement.innerHTML;
                // Use innerHTML with <br> for proper measurement
                textElement.innerHTML = originalText.replace(/\n/g, '<br>');
                const fullHeight = heading.offsetHeight;
                textElement.innerHTML = currentContent;
                heading.style.minHeight = fullHeight + 'px';
              };

              const typeWriter = () => {
                if (isTyping) {
                  if (charIndex < originalText.length) {
                    // Convert \n to <br> for proper line breaks
                    const displayText = originalText.substring(0, charIndex + 1).replace(/\n/g, '<br>');
                    textElement.innerHTML = displayText;
                    // Set min-height on first character to lock layout
                    if (charIndex === 0) {
                      setTimeout(setMinHeight, 50);
                    }
                    charIndex++;
                    setTimeout(typeWriter, typingSpeed);
                  } else {
                    textElement.classList.add('typing');
                    setTimeout(() => {
                      isTyping = false;
                      textElement.classList.remove('typing');
                      typeWriter();
                    }, pauseDuration);
                  }
                } else {
                  if (charIndex > 0) {
                    // Convert \n to <br> for proper line breaks during erasing
                    const displayText = originalText.substring(0, charIndex - 1).replace(/\n/g, '<br>');
                    textElement.innerHTML = displayText;
                    charIndex--;
                    setTimeout(typeWriter, erasingSpeed);
                  } else {
                    setTimeout(() => {
                      isTyping = true;
                      typeWriter();
                    }, pauseDuration / 2);
                  }
                }
              };

              // Start typing immediately
              typeWriter();
            }
          }
        });
      }

      setupEventListeners() {
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            if (this.autoplay) {
              this.resetAutoplay();
            }
          });
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots.length > 0) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots.length > 0) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.interval);
      }

      resetAutoplay() {
        clearInterval(this.autoplayInterval);
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('hero-slider-{{ ai_gen_id }}', HeroSlider{{ ai_gen_id }});
  })();
</script>

