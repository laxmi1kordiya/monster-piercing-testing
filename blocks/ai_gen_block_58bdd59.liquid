          font-weight: 400;
          font-style: normal;
        {% when 'norican' %}
          font-family: 'Norican', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'cookie' %}
          font-family: 'Cookie', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'leckerli_one' %}
          font-family: 'Leckerli One', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'yellowtail' %}
          font-family: 'Yellowtail', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'montez' %}
          font-family: 'Montez', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'devonshire' %}
          font-family: 'Devonshire', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'engagement' %}
          font-family: 'Engagement', cursive;
          font-weight: 400;
          font-style: normal;
      {% endcase %}
    {% else %}
      font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
      font-weight: {{ block.settings.heading_font.weight }};
      font-style: {{ block.settings.heading_font.style }};
    {% endif %}
    line-height: 1.3;
    display: block;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    {% if block.settings.text_shadow_style == 'custom' %}
      text-shadow: {{ block.settings.text_shadow_custom }};
    {% else %}
      text-shadow: {{ block.settings.text_shadow_style }};
    {% endif %}
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .ai-hero-slider__heading-wrapper-{{ ai_gen_id }} {
    display: block;
    margin-bottom: {{ block.settings.heading_spacing }}px;
    position: relative;
  }

  {% if block.settings.enable_typewriter %}
  .ai-hero-slider__heading-{{ ai_gen_id }} .typewriter-text {
    border-right: {{ block.settings.cursor_width }}px solid {{ block.settings.cursor_color }};
    padding-right: 5px;
    animation: blink-cursor {{ block.settings.cursor_blink_speed }}s step-end infinite;
    display: inline;
    visibility: visible;
  }

  @keyframes blink-cursor {
    0%, 100% { border-color: {{ block.settings.cursor_color }}; }
    50% { border-color: transparent; }
  }

  .ai-hero-slider__heading-{{ ai_gen_id }} .typewriter-text.typing {
    border-color: {{ block.settings.cursor_color }};
  }
  {% endif %}

  .ai-hero-slider__description-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.description_spacing }}px;
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    {% if block.settings.use_custom_desc_font %}
