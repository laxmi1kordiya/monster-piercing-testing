{% style %}
  .ai-hero-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-hero-slider__slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 2000 / 700;
  }

  .ai-hero-slider__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
    pointer-events: none;
  }

  .ai-hero-slider__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-hero-slider__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .ai-hero-slider__background-mobile-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    display: none;
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-slider__placeholder-mobile-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slider__placeholder-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-slider__placeholder-mobile-{{ ai_gen_id }} {
      display: flex;
    }
  }

  .ai-hero-slider__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-hero-slider__content-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    {% if block.settings.constrain_content_area %}
      {% if block.settings.content_alignment == 'flex-start' %}
        left: 0;
        width: {{ block.settings.content_area_width }}%;
      {% elsif block.settings.content_alignment == 'flex-end' %}
        right: 0;
        width: {{ block.settings.content_area_width }}%;
      {% else %}
        left: 0;
        width: 100%;
      {% endif %}
    {% else %}
      left: 0;
      width: 100%;
    {% endif %}
    height: 100%;
    display: flex;
    align-items: {{ block.settings.content_vertical_alignment }};
    justify-content: {{ block.settings.content_alignment }};
    z-index: 3;
    padding: 40px 20px;
  }

  .ai-hero-slider__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
    text-align: {{ block.settings.text_alignment }};
    {% if block.settings.constrain_content_area %}
      padding: 0 20px;
    {% endif %}
  }

  .ai-hero-slider__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    visibility: visible;
    opacity: 1;
    {% if block.settings.use_custom_font %}
      {% case block.settings.cursive_font_style %}
        {% when 'playfair_display' %}
          font-family: 'Playfair Display', serif;
          font-weight: {{ block.settings.cursive_font_weight }};
          font-style: {{ block.settings.font_style_italic }};
        {% when 'cormorant_garamond' %}
          font-family: 'Cormorant Garamond', serif;
          font-weight: {{ block.settings.cursive_font_weight }};
          font-style: {{ block.settings.font_style_italic }};
        {% when 'italiana' %}
          font-family: 'Italiana', serif;
          font-weight: 400;
          font-style: normal;
        {% when 'satisfy' %}
          font-family: 'Satisfy', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'pacifico' %}
          font-family: 'Pacifico', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'lobster_two' %}
          font-family: 'Lobster Two', display;
          font-weight: {{ block.settings.cursive_font_weight }};
          font-style: {{ block.settings.font_style_italic }};
        {% when 'kaushan_script' %}
          font-family: 'Kaushan Script', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'cinzel' %}
          font-family: 'Cinzel', serif;
          font-weight: {{ block.settings.cursive_font_weight }};
          font-style: normal;
        {% when 'great_vibes' %}
          font-family: 'Great Vibes', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'allura' %}
          font-family: 'Allura', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'dancing_script' %}
