          font-style: normal;
        {% when 'parisienne' %}
          font-family: 'Parisienne', cursive;
          font-weight: 400;
          font-style: normal;
        {% when 'tangerine' %}
          font-family: 'Tangerine', cursive;
          font-weight: {{ block.settings.cursive_font_weight }};
