</header-search-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderSearch{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.searchTimeout = null;
        this.abortController = null;
      }

      connectedCallback() {
        this.form = this.querySelector('.ai-header-search-form-{{ ai_gen_id }}');
        this.input = this.querySelector('[data-predictive-search-input]');
        this.resultsContainer = this.querySelector('[data-predictive-search-results]');
        this.loadingEl = this.querySelector('[data-search-loading]');
        this.contentEl = this.querySelector('[data-search-content]');

        if (this.form && this.input) {
          this.form.addEventListener('submit', (e) => {
            if (!this.input.value.trim()) {
              e.preventDefault();
            }
          });

          // Predictive search
          this.input.addEventListener('input', this.handleInput.bind(this));
          this.input.addEventListener('focus', this.handleFocus.bind(this));

          // Close on click outside
          document.addEventListener('click', (e) => {
            if (!this.contains(e.target)) {
              this.closeResults();
            }
          });

          // Close on escape
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              this.closeResults();
            }
          });
        }

        // Initialize currency selectors
        this.initCurrencySelectors();

        // Initialize hamburger menu
        this.initHamburgerMenu();
      }

      initHamburgerMenu() {
        // Use setTimeout to ensure DOM is fully loaded
        setTimeout(() => {
          const menuToggle = this.querySelector('[data-menu-toggle]');
          const mobileNav = document.querySelector('[data-mobile-nav]');
          const mobileNavPanel = document.querySelector('[data-mobile-nav-panel]');
          const mobileNavOverlay = document.querySelector('[data-mobile-nav-overlay]');
          const closeBtn = document.querySelector('[data-mobile-nav-close]');



          if (menuToggle && mobileNav && mobileNavPanel) {
            // Initialize submenu accordions
            this.initMobileSubmenus(mobileNavPanel);

            // Remove any existing listeners by cloning
            const newToggle = menuToggle.cloneNode(true);
            menuToggle.parentNode.replaceChild(newToggle, menuToggle);

            // Toggle function
            const toggleMenu = (open) => {
              if (open) {
                // Open menu - use dataset.open like the theme does
                mobileNav.dataset.open = 'true';
                mobileNavPanel.setAttribute('data-animation-state', 'open');
                if (mobileNavOverlay) mobileNavOverlay.setAttribute('data-animation-state', 'open');
                newToggle.setAttribute('aria-expanded', 'true');

                // Prevent body scroll
                document.body.style.overflow = 'hidden';
                document.documentElement.style.overflow = 'hidden';

                // Close search results when mobile nav opens (mobile only)
                if (window.innerWidth < 1024) {
                  this.closeResults();
                  if (this.input) this.input.blur();
                }
              } else {
                // Close menu
                mobileNav.dataset.open = 'false';
                mobileNavPanel.setAttribute('data-animation-state', 'closed');
                if (mobileNavOverlay) mobileNavOverlay.setAttribute('data-animation-state', 'closed');
                newToggle.setAttribute('aria-expanded', 'false');

                // Restore body scroll
                document.body.style.overflow = '';
                document.documentElement.style.overflow = '';
              }
            };

            // Main toggle click
            newToggle.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              const isOpen = mobileNav.dataset.open === 'true';
              toggleMenu(!isOpen);
            });

            // Close menu when overlay is clicked
            if (mobileNavOverlay) {
              mobileNavOverlay.addEventListener('click', () => {
                toggleMenu(false);
              });
            }

            // Close menu when close button is clicked
            if (closeBtn) {
              closeBtn.addEventListener('click', (e) => {
                e.preventDefault();
                toggleMenu(false);
              });
            }

            // Close on escape key
            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape' && mobileNav.dataset.open === 'true') {
                toggleMenu(false);
              }
            });
          } else {
            console.error('Hamburger menu elements not found:', { menuToggle, mobileNav, mobileNavPanel });
          }
        }, 250);
      }

      initMobileSubmenus(panel) {
        // Helper function to close a submenu
        const closeSubmenu = (submenu, link, button) => {
          submenu.style.display = 'none';
          submenu.style.maxHeight = '0';
          link.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-expanded', 'false');
          link.classList.remove('navmenu-link-parent-active');

          // Close all child submenus
          const childSubmenus = submenu.querySelectorAll('[data-navmenu-submenu], [data-accordion-content]');
          childSubmenus.forEach(child => {
            child.style.display = 'none';
            child.style.maxHeight = '0';
          });

          const childLinks = submenu.querySelectorAll('.navmenu-link-parent');
          childLinks.forEach(child => {
            child.setAttribute('aria-expanded', 'false');
            child.classList.remove('navmenu-link-parent-active');
          });

          const childButtons = submenu.querySelectorAll('.navmenu-button');
          childButtons.forEach(child => {
            child.setAttribute('aria-expanded', 'false');
          });
        };

        // Helper function to open a submenu
        const openSubmenu = (submenu, link, button) => {
          // Set display and positioning for proper flow
          submenu.style.display = 'block';
          submenu.style.position = 'relative';
          submenu.style.height = 'auto';
          submenu.style.maxHeight = 'none';
          submenu.style.visibility = 'visible';
          submenu.style.opacity = '1';
          submenu.style.overflow = 'visible';

          // Also update all parent submenus to expand and flow properly
          let parent = submenu.parentElement;
          while (parent && parent !== panel) {
            if (parent.hasAttribute('data-navmenu-submenu') || parent.hasAttribute('data-accordion-content')) {
              parent.style.display = 'block';
              parent.style.position = 'relative';
              parent.style.height = 'auto';
              parent.style.maxHeight = 'none';
              parent.style.visibility = 'visible';
              parent.style.opacity = '1';
              parent.style.overflow = 'visible';
            }
            parent = parent.parentElement;
          }

          // Make all direct list items visible
          const listItems = submenu.querySelectorAll(':scope > li');
          listItems.forEach(item => {
            item.style.display = 'block';
            item.style.opacity = '1';
            item.style.visibility = 'visible';
            item.style.transform = 'none';
            item.style.height = 'auto';
          });

          link.setAttribute('aria-expanded', 'true');
          button.setAttribute('aria-expanded', 'true');
          link.classList.add('navmenu-link-parent-active');
        };

        // Close all submenus initially
        const allSubmenus = panel.querySelectorAll('[data-navmenu-submenu], [data-accordion-content]');
        allSubmenus.forEach(submenu => {
          submenu.style.display = 'none';
          submenu.style.maxHeight = '0';
          submenu.style.overflow = 'hidden';
        });

        // Set all parent links to collapsed state
        const allParentLinks = panel.querySelectorAll('[data-navmenu-parent]');
        allParentLinks.forEach(link => {
          link.setAttribute('aria-expanded', 'false');
          link.classList.remove('navmenu-link-parent-active');
        });

        // Set all buttons to collapsed state
        const allButtons = panel.querySelectorAll('.navmenu-button');
        allButtons.forEach(button => {
          button.setAttribute('aria-expanded', 'false');
        });

        // Add click handlers for submenu toggles
        allParentLinks.forEach(parentLink => {
          const listItem = parentLink.closest('li');
          if (!listItem) return;

          const button = listItem.querySelector('.navmenu-button');
          const submenu = listItem.querySelector('[data-navmenu-submenu]');

          if (!button || !submenu) return;

          // Remove existing listeners
          const newButton = button.cloneNode(true);
          button.parentNode.replaceChild(newButton, button);

          newButton.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const isExpanded = parentLink.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
              // Close this submenu
              closeSubmenu(submenu, parentLink, newButton);
            } else {
              // Find and close all sibling submenus at the same level
              const parentContainer = listItem.parentElement;
              const siblingItems = Array.from(parentContainer.children).filter(
                item => item !== listItem && item.querySelector('[data-navmenu-submenu]')
              );

              siblingItems.forEach(siblingItem => {
                const siblingSubmenu = siblingItem.querySelector('[data-navmenu-submenu]');
                const siblingLink = siblingItem.querySelector('[data-navmenu-parent]');
                const siblingButton = siblingItem.querySelector('.navmenu-button');

                if (siblingSubmenu && siblingLink && siblingButton) {
                  if (siblingLink.getAttribute('aria-expanded') === 'true') {
                    closeSubmenu(siblingSubmenu, siblingLink, siblingButton);
                  }
                }
              });

              // Open this submenu
              openSubmenu(submenu, parentLink, newButton);
            }
          });
        });
      }

      handleInput(e) {
        const query = e.target.value.trim();

        clearTimeout(this.searchTimeout);

        if (query.length < 2) {
          this.closeResults();
          return;
        }

        this.searchTimeout = setTimeout(() => {
          this.performSearch(query);
        }, 300);
      }

      handleFocus() {
        // Close mobile nav when search is focused (mobile only)
        if (window.innerWidth < 1024) {
          const mobileNav = document.querySelector('[data-mobile-nav]');
          const mobileNavPanel = document.querySelector('[data-mobile-nav-panel]');
          const mobileNavOverlay = document.querySelector('[data-mobile-nav-overlay]');
          const menuToggle = document.querySelector('[data-menu-toggle]');

          if (mobileNav && mobileNav.dataset.open === 'true') {
            mobileNav.dataset.open = 'false';
            if (mobileNavPanel) mobileNavPanel.setAttribute('data-animation-state', 'closed');
            if (mobileNavOverlay) mobileNavOverlay.setAttribute('data-animation-state', 'closed');
            if (menuToggle) menuToggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            document.documentElement.style.overflow = '';
          }
        }

        const query = this.input.value.trim();
        if (query.length >= 2 && this.contentEl.innerHTML) {
          this.openResults();
        }
      }

      async performSearch(query) {
        if (this.abortController) {
          this.abortController.abort();
        }

        this.abortController = new AbortController();
        this.showLoading();
        this.openResults();

        try {
          const searchQuery = query.trim();

          // Fetch from predictive search API
          const suggestResponse = await fetch(
            `/search/suggest.json?q=${encodeURIComponent(searchQuery)}&resources[type]=product,collection,page,article,query&resources[limit]=10`,
            { signal: this.abortController.signal }
          );

          let data = { resources: { results: { products: [], queries: [], collections: [], pages: [], articles: [] } } };

          // Get predictive search results
          if (suggestResponse.ok) {
            data = await suggestResponse.json();
          }

          // Try to get more products from custom JSON template
          try {
            const jsonResponse = await fetch(
              `/search?view=json&q=${encodeURIComponent(searchQuery)}`,
              { signal: this.abortController.signal }
            );

            if (jsonResponse.ok) {
              const jsonText = await jsonResponse.text();
              // Check if response starts with valid JSON
              const trimmedText = jsonText.trim();
              if (trimmedText.startsWith('{')) {
                const jsonData = JSON.parse(trimmedText);
                if (jsonData.products && jsonData.products.length > 0) {
                  // Merge products, keeping unique ones by ID
                  const existingIds = new Set((data.resources?.results?.products || []).map(p => p.id));
                  const additionalProducts = jsonData.products.filter(p => !existingIds.has(p.id));

                  data.resources = data.resources || { results: {} };
                  data.resources.results = data.resources.results || {};
                  data.resources.results.products = [
                    ...(data.resources.results.products || []),
                    ...additionalProducts
                  ].slice(0, 20);

                }
              }
            }
          } catch(e) {
          }

          this.renderResults(data, searchQuery);
        } catch (error) {
          if (error.name !== 'AbortError') {
            console.error('Search error:', error);
            this.hideLoading();
          }
        }
      }

      renderResults(data, query) {
        this.hideLoading();
        const resources = data.resources?.results || {};
        const queries = resources.queries || [];
        const products = resources.products || [];
        const pages = resources.pages || [];
        const articles = resources.articles || [];
        const collections = resources.collections || [];

        // Get recent searches from localStorage
        let recentSearches = [];
        try {
          recentSearches = JSON.parse(localStorage.getItem('recentSearches') || '[]').slice(0, 5);
        } catch(e) {}

        // Save current search to recent
        if (query && query.length >= 2) {
          let searches = recentSearches.filter(s => s.toLowerCase() !== query.toLowerCase());
          searches.unshift(query);
          searches = searches.slice(0, 5);
          try {
            localStorage.setItem('recentSearches', JSON.stringify(searches));
          } catch(e) {}
        }

        let html = '<div class="ai-search-results__wrapper-{{ ai_gen_id }}">';

        // LEFT SIDEBAR
        html += '<div class="ai-search-results__left-{{ ai_gen_id }}">';

        // Your Search Queries (recent searches)
        if (recentSearches.length > 0 || queries.length > 0) {
          html += `<div class="ai-search-results__section-{{ ai_gen_id }}">`;
          html += `<div class="ai-search-results__title-{{ ai_gen_id }}">Your Search Queries</div>`;
          html += `<ul class="ai-search-suggestions-{{ ai_gen_id }}">`;

          // Show recent searches first
          recentSearches.forEach(s => {
            html += `<li><a href="/search?q=${encodeURIComponent(s)}">${s}</a></li>`;
          });

          html += '</ul></div>';
        }

        // Categories
        html += `<div class="ai-search-results__section-{{ ai_gen_id }}">`;
        html += `<div class="ai-search-results__title-{{ ai_gen_id }}">Categories</div>`;
        html += `<ul class="ai-search-categories-{{ ai_gen_id }}">`;

        if (collections.length > 0) {
          collections.forEach(col => {
            html += `<li><a href="${col.url}">${col.title}</a></li>`;
          });
        } else {
          // Show product types/tags as categories from products
          const categories = [...new Set(products.map(p => p.type).filter(Boolean))].slice(0, 5);
          if (categories.length > 0) {
            categories.forEach(cat => {
              html += `<li><a href="/collections/all?filter.p.product_type=${encodeURIComponent(cat)}">${cat}</a></li>`;
            });
          } else {
            html += `<li><a href="/collections/all">All Products</a></li>`;
          }
        }
        html += '</ul></div>';

        // Popular Products (text links in sidebar)
        if (products.length > 0) {
          html += `<div class="ai-search-results__section-{{ ai_gen_id }}">`;
          html += `<div class="ai-search-results__title-{{ ai_gen_id }}">Popular Products</div>`;
          html += `<ul class="ai-search-popular-{{ ai_gen_id }}">`;
          products.slice(0, 5).forEach(product => {
            html += `<li><a href="${product.url}">${product.title}</a></li>`;
          });
          html += '</ul></div>';
        }

        html += '</div>'; // End left sidebar

        // RIGHT CONTENT AREA
        html += '<div class="ai-search-results__right-{{ ai_gen_id }}">';

        // Pages as pills/tags
        if (pages.length > 0 || articles.length > 0 || queries.length > 0) {
          html += `<div class="ai-search-results__section-{{ ai_gen_id }}">`;
          html += `<div class="ai-search-results__title-{{ ai_gen_id }}">Pages</div>`;

          // Info message
          const totalResults = products.length;
          html += `<div class="ai-search-info-{{ ai_gen_id }}">`;
          if (totalResults > 0) {
            html += `Showing <strong>${totalResults}</strong> results for <strong>${query}</strong>. Did you mean: `;
          } else {
            html += `Sorry, nothing found for <strong>${query}</strong>. Did you mean: `;
          }
          html += '</div>';

          // Suggestion pills
          html += `<div class="ai-search-pages-{{ ai_gen_id }}">`;
          queries.slice(0, 5).forEach(q => {
            html += `<a href="/search?q=${encodeURIComponent(q.text)}">${q.text}</a>`;
          });
          if (queries.length === 0) {
            html += `<a href="/search?q=${encodeURIComponent(query)}">${query}</a>`;
          }
          html += '</div></div>';
        }

        // Products Grid
        if (products.length > 0) {
          html += `<div class="ai-search-results__section-{{ ai_gen_id }}">`;
          html += `<div class="ai-search-results__title-{{ ai_gen_id }}">Products</div>`;
          html += `<div class="ai-search-products-grid-{{ ai_gen_id }}">`;

          products.forEach(product => {
            const imageUrl = product.image ? product.image.replace(/(\.[a-z]+)(\?.*)?$/, '_300x300$1$2') : '';
            const comparePrice = product.compare_at_price && product.compare_at_price > product.price
              ? `<span class="compare-price">${this.formatMoney(product.compare_at_price)}</span>`
              : '';

            // Build badges HTML
            let badgesHtml = '';
            const hasBadges = product.is_best_seller || product.is_new || (product.inventory_quantity !== undefined && product.inventory_quantity > 0 && product.inventory_quantity < 10);

            if (hasBadges) {
              badgesHtml = '<div class="ai-search-product-card__badges-{{ ai_gen_id }}">';
              if (product.is_best_seller) {
                badgesHtml += '<span class="ai-search-product-card__badge-{{ ai_gen_id }} ai-search-product-card__badge--bestseller-{{ ai_gen_id }}">Best Seller</span>';
              }
              if (product.is_new) {
                badgesHtml += '<span class="ai-search-product-card__badge-{{ ai_gen_id }} ai-search-product-card__badge--new-{{ ai_gen_id }}">New</span>';
              }
              if (product.inventory_quantity !== undefined && product.inventory_quantity > 0 && product.inventory_quantity < 10) {
                badgesHtml += '<span class="ai-search-product-card__badge-{{ ai_gen_id }} ai-search-product-card__badge--lowstock-{{ ai_gen_id }}">Low Stock</span>';
              }
              badgesHtml += '</div>';
            }

            html += `
              <a href="${product.url}" class="ai-search-product-card-{{ ai_gen_id }}">
                <div class="ai-search-product-card__image-wrapper-{{ ai_gen_id }}">
                  ${badgesHtml}
                  <div class="ai-search-product-card__image-{{ ai_gen_id }}">
                    ${imageUrl ? `<img src="${imageUrl}" alt="${product.title}" loading="lazy">` : ''}
                  </div>
                </div>
                <div class="ai-search-product-card__vendor-{{ ai_gen_id }}">${product.vendor || ''}</div>
                <div class="ai-search-product-card__title-{{ ai_gen_id }}">${product.title}</div>
                <div class="ai-search-product-card__price-{{ ai_gen_id }}">
                  ${this.formatMoney(product.price)}${comparePrice}
                </div>
                <div class="ai-search-product-card__rating-{{ ai_gen_id }}">★★★★★</div>
              </a>
            `;
          });

          html += '</div></div>';
        }

        html += '</div>'; // End right content
        html += '</div>'; // End wrapper

        // Search all button
        html += `
          <div class="ai-search-all-{{ ai_gen_id }}">
            <a href="/search?q=${encodeURIComponent(query)}">View All Results for "${query}"</a>
          </div>
        `;

        this.contentEl.innerHTML = html;

        // Trigger currency converter to update dynamically loaded prices
        this.triggerCurrencyConversion();
      }

      triggerCurrencyConversion() {
        const shopCurrency = '{{ shop.currency }}';

        // Try various currency converter app methods
        setTimeout(() => {
          // Bucks Currency Converter - convert .money elements
          if (window.Currency && typeof window.Currency.convertAll === 'function') {
            const targetCurrency = window.Currency.currentCurrency || window.Currency.cookie?.read('currency') || shopCurrency;
            window.Currency.convertAll(shopCurrency, targetCurrency);
          }

          // DoublyGlobalCurrency (some Bucks versions)
          if (window.DoublyGlobalCurrency && typeof window.DoublyGlobalCurrency.convertAll === 'function') {
            const targetCurrency = window.Currency?.currentCurrency || shopCurrency;
            window.DoublyGlobalCurrency.convertAll(shopCurrency, targetCurrency);
          }

          // Dispatch events for other converters that listen to DOM changes
          document.dispatchEvent(new CustomEvent('shopify:section:load'));
          document.dispatchEvent(new CustomEvent('currency:update'));

          // Also try to find and trigger any span.money elements update
          const moneyElements = this.contentEl?.querySelectorAll('.money');
          if (moneyElements && window.Currency && window.Currency.convertAll) {
            window.Currency.convertAll(shopCurrency, window.Currency.currentCurrency || shopCurrency, '.money');
          }
        }, 150);
      }

      highlightQuery(text, query) {
        const regex = new RegExp(`(${query})`, 'gi');
        return text.replace(regex, '<strong>$1</strong>');
      }

      formatMoney(price) {
        const shopCurrency = '{{ shop.currency }}';
        const moneyFormat = window.Theme?.moneyFormat || '{{ shop.money_format }}';

        // Normalize price to cents
        // Suggest API returns price as a dollar string (e.g., "49.99")
        // search.json.liquid returns price as an integer in cents (e.g., 4999)
        let cents = price;
        if (typeof cents === 'string') {
          cents = cents.includes('.') ? Math.round(parseFloat(cents) * 100) : parseInt(cents, 10);
        }

        // Format price in shop's base currency - let the Bucks app handle conversion via convertAll()
        let formattedPrice;
        if (window.Shopify && window.Shopify.formatMoney) {
          formattedPrice = Shopify.formatMoney(cents, moneyFormat);
        } else {
          const amount = (cents / 100).toFixed(2);
          formattedPrice = `{{ cart.currency.symbol }}${amount}`;
        }

        // Return with money class and data attributes for Bucks app to convert
        return `<span class="money" data-currency-original="${cents}" data-currency="${shopCurrency}">${formattedPrice}</span>`;
      }

      showLoading() {
        if (this.loadingEl) this.loadingEl.style.display = 'block';
        if (this.contentEl) this.contentEl.innerHTML = '';
      }

      hideLoading() {
        if (this.loadingEl) this.loadingEl.style.display = 'none';
      }

      openResults() {
        if (this.resultsContainer) {
          this.resultsContainer.classList.add('active');
        }
      }

      closeResults() {
        if (this.resultsContainer) {
          this.resultsContainer.classList.remove('active');
        }
      }

      initCurrencySelectors() {
        const allSelectors = document.querySelectorAll('.ai-currency-selector-{{ ai_gen_id }}');

        allSelectors.forEach(selector => {
          const trigger = selector.querySelector('.ai-currency-selector__trigger-{{ ai_gen_id }}');
          const options = selector.querySelectorAll('[data-currency-option]');

          if (trigger) {
            trigger.addEventListener('click', (e) => {
              e.stopPropagation();

              allSelectors.forEach(s => {
                if (s !== selector) {
                  s.classList.remove('open');
                  const otherTrigger = s.querySelector('.ai-currency-selector__trigger-{{ ai_gen_id }}');
                  if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
                }
              });

              const isOpen = selector.classList.toggle('open');
              trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });
          }

          options.forEach(option => {
            option.addEventListener('click', (e) => {
              e.stopPropagation();
              const currency = option.dataset.currencyOption;

              if (currency === 'auto') {
                document.cookie = 'cart_currency=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                window.location.reload();
              } else {
                this.changeCurrency(currency);
              }
            });
          });
        });

        document.addEventListener('click', () => {
          allSelectors.forEach(selector => {
            selector.classList.remove('open');
            const trigger = selector.querySelector('.ai-currency-selector__trigger-{{ ai_gen_id }}');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
          });
        });

        // Initialize floating currency selector for mobile
        this.initFloatingCurrencySelector();
      }

      initFloatingCurrencySelector() {
        const floatingSelector = document.querySelector('.ai-floating-currency-{{ ai_gen_id }}');
        if (!floatingSelector) return;

        const trigger = floatingSelector.querySelector('.ai-floating-currency__btn-{{ ai_gen_id }}');
        const options = floatingSelector.querySelectorAll('[data-floating-currency-option]');

        if (trigger) {
          trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = floatingSelector.classList.toggle('open');
            trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });
        }

        options.forEach(option => {
          option.addEventListener('click', (e) => {
            e.stopPropagation();
            const currency = option.dataset.floatingCurrencyOption;

            if (currency === 'auto') {
              document.cookie = 'cart_currency=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
              window.location.reload();
            } else {
              this.changeCurrency(currency);
            }
          });
        });

        document.addEventListener('click', () => {
          floatingSelector.classList.remove('open');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        });
      }

      changeCurrency(currencyCode) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/cart/update';
        form.style.display = 'none';

        const currencyInput = document.createElement('input');
        currencyInput.type = 'hidden';
        currencyInput.name = 'currency';
        currencyInput.value = currencyCode;
        form.appendChild(currencyInput);

        const returnInput = document.createElement('input');
        returnInput.type = 'hidden';
        returnInput.name = 'return_to';
        returnInput.value = window.location.pathname + window.location.search;
        form.appendChild(returnInput);

        document.body.appendChild(form);
        form.submit();
      }
    }

    customElements.define('header-search-{{ ai_gen_id }}', HeaderSearch{{ ai_gen_id }});
  })();
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const profileButton = document.querySelector('.ai-profile-icon');
    const profileWrapper = document.querySelector('.ai-profile-wrapper');

    if (profileButton && profileWrapper) {
      profileButton.addEventListener('click', function(e) {
        e.preventDefault();

        /* On mobile (max-width: 1023px), navigate directly to account page */
        if (window.innerWidth <= 1023) {
          const accountUrl = profileWrapper.getAttribute('data-account-url');
          if (accountUrl) {
            window.location.href = accountUrl;
            return;
          }
        }

        /* On desktop, toggle dropdown */
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !isExpanded);
      });

      /* Close dropdown when clicking outside */
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.ai-profile-wrapper')) {
          profileButton.setAttribute('aria-expanded', 'false');
        }
      });
    }
  });
</script>

{% if block.settings.enable_sticky_scroll %}
<script>
  (function() {
    document.addEventListener('DOMContentLoaded', function() {
      var headerBlock = document.querySelector('.ai-header-{{ ai_gen_id }}');
      if (!headerBlock) return;

      var headerSection = headerBlock.closest('.shopify-section');
      if (!headerSection) return;

      var headerHeight = headerSection.offsetHeight;
      var headerOffsetTop = headerSection.offsetTop + headerHeight + 46;
      var isFixed = false;
      var placeholder = null;

      function makeFixed() {
        if (isFixed) return;
        headerSection.style.position = 'fixed';
        headerSection.style.top = '0';
        headerSection.style.left = '0';
        headerSection.style.right = '0';
        headerSection.style.width = '100%';
        headerSection.style.zIndex = '1501';
        headerSection.style.transition = 'transform 0.3s ease';
        headerSection.style.transform = 'translateY(0)';

        if (!placeholder) {
          placeholder = document.createElement('div');
          placeholder.id = 'header-placeholder';
          headerSection.parentNode.insertBefore(placeholder, headerSection);
        }
        placeholder.style.height = headerHeight + 'px';
        isFixed = true;
      }

      function makeNormal() {
        if (!isFixed) return;
        headerSection.style.position = '';
        headerSection.style.top = '';
        headerSection.style.left = '';
        headerSection.style.right = '';
        headerSection.style.width = '';
        headerSection.style.zIndex = '';
        headerSection.style.boxShadow = '';
        headerSection.style.transition = '';
        headerSection.style.transform = '';

        if (placeholder) {
          placeholder.style.height = '0px';
        }
        isFixed = false;
      }

      var ticking = false;
      window.addEventListener('scroll', function() {
        if (!ticking) {
          requestAnimationFrame(function() {
            if (window.scrollY > headerOffsetTop) {
              makeFixed();
            } else {
              makeNormal();
            }
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });

      window.addEventListener('resize', function() {
        headerHeight = headerSection.offsetHeight;
        headerOffsetTop = headerSection.offsetTop + headerHeight + 46;
        if (placeholder && isFixed) {
          placeholder.style.height = headerHeight + 'px';
        }
      });
    });
  })();
</script>
{% endif %}
 <script>
  (function() {
    var STORAGE_KEY = 'mp_wl_count';

    function updateWishlistBadge(count) {
      document.querySelectorAll('[data-wl-count]').forEach(function(el) {
        el.textContent = count > 0 ? count : '';
        el.classList.toggle('visible', count > 0);
      });
    }

    // Show cached count immediately (no API wait)
    var cached = parseInt(localStorage.getItem(STORAGE_KEY) || '0');
    if (cached > 0) updateWishlistBadge(cached);

    // Watch for WishlistHero updating the count span, then save + sync our badge
    document.addEventListener('DOMContentLoaded', function() {
      var observer = new MutationObserver(function() {
        var whSpan = document.querySelector('.wishlist-hero-items-count');
        if (!whSpan) return;
        var count = parseInt(whSpan.textContent) || 0;
        localStorage.setItem(STORAGE_KEY, count);
        updateWishlistBadge(count);
      });
      observer.observe(document.body, { childList: true, subtree: true, characterData: true });
    });
  })();
</script>

