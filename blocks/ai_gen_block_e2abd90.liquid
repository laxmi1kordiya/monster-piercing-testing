{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    padding: 5px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    display: block;
    contain: layout style;
    height: {{ block.settings.desktop_circle_size | plus: block.settings.padding_bottom | plus: 10 }}px;
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    height: {{ block.settings.desktop_circle_size }}px;
  }

  .ai-collection-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.desktop_item_spacing }}px;
    will-change: transform;
    height: {{ block.settings.desktop_circle_size }}px;
  }


  .ai-collection-carousel__item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-collection-carousel__circle-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_circle_size }}px;
    height: {{ block.settings.desktop_circle_size }}px;
    position: relative;
  }

  .ai-collection-carousel__circle-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    border: {{ block.settings.desktop_border_width }}px solid {{ block.settings.desktop_border_color }};
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-collection-carousel__circle-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
  }

  .ai-collection-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-collection-carousel__text-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: {{ block.settings.desktop_overlay_height }}%;
    background: transparent;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 10px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease, background 0.3s ease;
    z-index: 2;
  }

  .ai-collection-carousel__circle-{{ ai_gen_id }}:hover .ai-collection-carousel__text-overlay-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
    background: linear-gradient({{ block.settings.desktop_overlay_angle }}deg, {{ block.settings.desktop_overlay_color }} 0%, transparent 100%);
  }

  .ai-collection-carousel__text-{{ ai_gen_id }} {
    color: {{ block.settings.desktop_text_color }};
    font-size: {{ block.settings.desktop_text_size }}px;
    font-weight: {{ block.settings.desktop_text_weight }};
    text-align: center;
    padding: 0 10px;
    line-height: 1.2;
    word-wrap: break-word;
    max-width: 90%;
  }

  .ai-collection-carousel__text-below-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_circle_size | plus: block.settings.padding_bottom | plus: 30 }}px;
    }

    .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
      height: {{ block.settings.mobile_circle_size | plus: 20 }}px;
    }

    .ai-collection-carousel__track-{{ ai_gen_id }} {
      height: auto;
    }

    .ai-collection-carousel__track-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_item_spacing }}px;
    }

    .ai-collection-carousel__item-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_text_spacing }}px;
    }

    .ai-collection-carousel__circle-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_circle_size }}px;
      height: {{ block.settings.mobile_circle_size }}px;
    }

    .ai-collection-carousel__circle-{{ ai_gen_id }} {
      border-width: {{ block.settings.mobile_border_width }}px;
      border-color: {{ block.settings.mobile_border_color }};
    }

    .ai-collection-carousel__text-overlay-{{ ai_gen_id }} {
      display: none;
    }

    .ai-collection-carousel__text-below-{{ ai_gen_id }} {
      display: block;
      color: {{ block.settings.mobile_text_color }};
      font-size: {{ block.settings.mobile_text_size }}px;
      font-weight: {{ block.settings.mobile_text_weight }};
      text-align: center;
      max-width: {{ block.settings.mobile_circle_size }}px;
      word-wrap: break-word;
      line-height: 1.2;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }}"
  data-direction="{{ block.settings.slide_direction }}"
  data-speed="{{ block.settings.slide_speed }}"
  data-auto-slide="{{ block.settings.auto_slide }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-carousel__wrapper-{{ ai_gen_id }}">
    <div class="ai-collection-carousel__track-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign image_key = 'image_' | append: i
          assign text_key = 'text_' | append: i
          assign collection = block.settings[collection_key]
          assign image = block.settings[image_key]
          assign text = block.settings[text_key]
        %}

        {% if collection != blank or image != blank %}
          <div class="ai-collection-carousel__item-{{ ai_gen_id }}">
            <div class="ai-collection-carousel__circle-wrapper-{{ ai_gen_id }}">
              <a
                href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}"
                class="ai-collection-carousel__circle-{{ ai_gen_id }}"
              >
                {% if image != blank %}
                  <img
                    src="{{ image | image_url: width: 100 }}"
                    alt="{{ image.alt | escape }}"
                    class="ai-collection-carousel__image-{{ ai_gen_id }}"
                    {% comment %} loading="lazy" {% endcomment %}
                    width="100"
                    height="100"
                  >
                {% elsif collection != blank and collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 100 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-collection-carousel__image-{{ ai_gen_id }}"
                    {% comment %} loading="lazy" {% endcomment %}
                    width="100"
                    height="100"
                  >
                {% else %}
                  <div class="ai-collection-carousel__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                <div class="ai-collection-carousel__text-overlay-{{ ai_gen_id }}">
                  <div class="ai-collection-carousel__text-{{ ai_gen_id }}">
                    {% if text != blank %}
                      {{ text }}
                    {% elsif collection != blank %}
                      {{ collection.title }}
                    {% else %}
                      Collection {{ i }}
                    {% endif %}
                  </div>
                </div>
              </a>
            </div>

            <div class="ai-collection-carousel__text-below-{{ ai_gen_id }}">
              {% if text != blank %}
                {{ text }}
              {% elsif collection != blank %}
                {{ collection.title }}
              {% else %}
                Collection {{ i }}
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-collection-carousel__track-{{ ai_gen_id }}');
        this.items = Array.from(this.querySelectorAll('.ai-collection-carousel__item-{{ ai_gen_id }}'));
        this.direction = this.dataset.direction;
        this.speed = parseFloat(this.dataset.speed);
        this.autoSlide = this.dataset.autoSlide === 'true';
        this.animationId = null;
        this.position = 0;
      }

      connectedCallback() {
        if (this.items.length === 0) return;

        this.isMobile = window.innerWidth <= 749;

        if (this.isMobile) {
          // Mobile: no cloning, no auto-slide — native touch scroll
          return;
        }

        this.cloneItems();
        this.setupInfiniteScroll();

        if (this.autoSlide) {
          this.startAutoSlide();
        }

        this.track.addEventListener('mouseenter', () => this.pauseAutoSlide());
        this.track.addEventListener('mouseleave', () => this.resumeAutoSlide());
      }

      cloneItems() {
        const cloneCount = Math.ceil(window.innerWidth / this.items[0].offsetWidth) + 2;
        
        for (let i = 0; i < cloneCount; i++) {
          this.items.forEach(item => {
            const clone = item.cloneNode(true);
            this.track.appendChild(clone);
          });
        }

        for (let i = 0; i < cloneCount; i++) {
          this.items.forEach(item => {
            const clone = item.cloneNode(true);
            this.track.insertBefore(clone, this.track.firstChild);
          });
        }
      }

      setupInfiniteScroll() {
        const itemWidth = this.items[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.track).gap) || 0;
        const totalItemWidth = itemWidth + gap;
        const originalSetWidth = this.items.length * totalItemWidth;

        this.position = -originalSetWidth * Math.ceil(window.innerWidth / this.items[0].offsetWidth);
        this.track.style.transform = `translateX(${this.position}px)`;
      }

      startAutoSlide() {
        if (!this.autoSlide) return;

        const animate = () => {
          const itemWidth = this.items[0].offsetWidth;
          const gap = parseInt(getComputedStyle(this.track).gap) || 0;
          const totalItemWidth = itemWidth + gap;
          const originalSetWidth = this.items.length * totalItemWidth;

          if (this.direction === 'left') {
            this.position -= this.speed;
          } else {
            this.position += this.speed;
          }

          this.track.style.transform = `translateX(${this.position}px)`;

          if (this.direction === 'left' && this.position <= -originalSetWidth * 2) {
            this.position += originalSetWidth;
          } else if (this.direction === 'right' && this.position >= 0) {
            this.position -= originalSetWidth;
          }

          this.animationId = requestAnimationFrame(animate);
        };

        this.animationId = requestAnimationFrame(animate);
      }

      pauseAutoSlide() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
          this.animationId = null;
        }
      }

      resumeAutoSlide() {
        if (this.autoSlide && !this.animationId) {
          this.startAutoSlide();
        }
      }

      disconnectedCallback() {
        this.pauseAutoSlide();
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

