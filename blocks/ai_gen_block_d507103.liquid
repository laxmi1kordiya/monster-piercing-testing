{% doc %}
  @prompt
    Generate a 6*1 grid of trust badges where I can add trust icons and single phrase text below it. Make sure these are scrollable horizontally in the mobile version instead of stacking one above each vertically., These should also be hover friendly, No need for the box outside 6 of the secrtions. Also, make sure the entire section is responsive considering the width.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-trust-badges-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-trust-badges-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.gap }}px;
    align-items: start;
  }

  .ai-trust-badge-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.icon_text_gap }}px;
    transition: transform 0.3s ease;
    cursor: pointer;
  }

  .ai-trust-badge-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-trust-badge-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .ai-trust-badge-item-{{ ai_gen_id }}:hover .ai-trust-badge-icon-{{ ai_gen_id }} {
    transform: scale({{ block.settings.icon_hover_scale }});
  }

  .ai-trust-badge-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-trust-badge-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-trust-badge-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-trust-badge-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.3;
    word-break: break-word;
    transition: color 0.3s ease;
  }

  .ai-trust-badge-item-{{ ai_gen_id }}:hover .ai-trust-badge-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_hover_color }};
  }

  .ai-trust-badge-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  /* Hide duplicate badges on desktop/tablet */
  .ai-trust-badge-duplicate-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .ai-trust-badges-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
      gap: {{ block.settings.tablet_gap }}px;
    }

    .ai-trust-badge-icon-{{ ai_gen_id }} {
      width: {{ block.settings.tablet_icon_size }}px;
      height: {{ block.settings.tablet_icon_size }}px;
    }

    .ai-trust-badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.tablet_text_size }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges-{{ ai_gen_id }} {
      padding: 30px 0;
      position: relative;
      overflow: hidden;
    }

    .ai-trust-badges-container-{{ ai_gen_id }} {
      width: 100%;
      overflow: hidden;
    }

    .ai-trust-badges-grid-{{ ai_gen_id }} {
      display: flex;
      gap: 0;
      padding: 0;
      width: max-content;
      /* Animation will be applied via JavaScript for accurate calculation */
    }

    .ai-trust-badges-grid-{{ ai_gen_id }}:hover {
      animation-play-state: paused;
    }

    .ai-trust-badge-item-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: {{ block.settings.mobile_item_width }}px;
      margin-right: {{ block.settings.mobile_gap }}px;
    }

    .ai-trust-badge-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-trust-badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    /* Show duplicate badges for seamless loop on mobile */
    .ai-trust-badge-duplicate-{{ ai_gen_id }} {
      display: flex;
    }

    a.ai-trust-badge-duplicate-{{ ai_gen_id }} {
      display: block;
    }

    /* Links also need margin */
    .ai-trust-badge-link-{{ ai_gen_id }} {
      flex: 0 0 auto;
      margin-right: {{ block.settings.mobile_gap }}px;
    }

    .ai-trust-badge-link-{{ ai_gen_id }} .ai-trust-badge-item-{{ ai_gen_id }} {
      margin-right: 0;
    }
  }

  /* Fallback animation - JavaScript will override with calculated distance */
  @keyframes trustBadgeScroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* No-JS fallback - apply animation via CSS if JS doesn't load */
  .no-js .ai-trust-badges-grid-{{ ai_gen_id }} {
    animation: trustBadgeScroll-{{ ai_gen_id }} 20s linear infinite;
  }
{% endstyle %}

<div class="ai-trust-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-badges-container-{{ ai_gen_id }}">
    <div class="ai-trust-badges-grid-{{ ai_gen_id }}">
      {%- comment -%} First set of badges {%- endcomment -%}
      {% for i in (1..5) %}
        {% liquid
          assign icon_key = 'badge_' | append: i | append: '_icon'
          assign text_key = 'badge_' | append: i | append: '_text'
          assign link_key = 'badge_' | append: i | append: '_link'
          assign icon = block.settings[icon_key]
          assign text = block.settings[text_key]
          assign link = block.settings[link_key]
        %}

        {% if link != blank %}
          <a href="{{ link }}" class="ai-trust-badge-link-{{ ai_gen_id }}">
        {% endif %}
        <div class="ai-trust-badge-item-{{ ai_gen_id }}">
          <div class="ai-trust-badge-icon-{{ ai_gen_id }}">
            {% if icon %}
              <img
                src="{{ icon | image_url: width: 200 }}"
                alt="{{ text | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-trust-badge-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if text != blank %}
            <div class="ai-trust-badge-text-{{ ai_gen_id }}">{{ text }}</div>
          {% endif %}
        </div>
        {% if link != blank %}
          </a>
        {% endif %}
      {% endfor %}

      {%- comment -%} Duplicate set for seamless mobile slider loop {%- endcomment -%}
      {% for i in (1..5) %}
        {% liquid
          assign icon_key = 'badge_' | append: i | append: '_icon'
          assign text_key = 'badge_' | append: i | append: '_text'
          assign link_key = 'badge_' | append: i | append: '_link'
          assign icon = block.settings[icon_key]
          assign text = block.settings[text_key]
          assign link = block.settings[link_key]
        %}

        {% if link != blank %}
          <a href="{{ link }}" class="ai-trust-badge-link-{{ ai_gen_id }} ai-trust-badge-duplicate-{{ ai_gen_id }}">
        {% endif %}
        <div class="ai-trust-badge-item-{{ ai_gen_id }} ai-trust-badge-duplicate-{{ ai_gen_id }}">
          <div class="ai-trust-badge-icon-{{ ai_gen_id }}">
            {% if icon %}
              <img
                src="{{ icon | image_url: width: 200 }}"
                alt="{{ text | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-trust-badge-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if text != blank %}
            <div class="ai-trust-badge-text-{{ ai_gen_id }}">{{ text }}</div>
          {% endif %}
        </div>
        {% if link != blank %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function() {
    const initTrustBadgeSlider = () => {
      const container = document.querySelector('.ai-trust-badges-{{ ai_gen_id }}');
      if (!container) return;

      const grid = container.querySelector('.ai-trust-badges-grid-{{ ai_gen_id }}');
      if (!grid) return;

      // Known values from settings - 5 badges with fixed width and gap
      const badgeCount = 5;
      const itemWidth = {{ block.settings.mobile_item_width | default: 100 }};
      const gap = {{ block.settings.mobile_gap | default: 20 }};

      // Calculate total width of first set: (item width + gap) × number of items
      const firstHalfWidth = badgeCount * (itemWidth + gap);

      const setupAnimation = () => {
        if (window.innerWidth <= 749) {
          // Set the scroll distance as a CSS variable
          grid.style.setProperty('--scroll-distance', `-${firstHalfWidth}px`);

          // Update animation to use the calculated distance
          grid.style.animation = 'none';
          grid.offsetHeight; // Trigger reflow
          grid.style.animation = `trustBadgeScrollCalc-{{ ai_gen_id }} 20s linear infinite`;
        } else {
          grid.style.animation = 'none';
        }
      };

      // Create dynamic keyframe animation
      const style = document.createElement('style');
      style.textContent = `
        @keyframes trustBadgeScrollCalc-{{ ai_gen_id }} {
          0% { transform: translateX(0); }
          100% { transform: translateX(var(--scroll-distance, -50%)); }
        }
      `;
      document.head.appendChild(style);

      setupAnimation();
      window.addEventListener('resize', setupAnimation);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTrustBadgeSlider);
    } else {
      initTrustBadgeSlider();
    }
  })();
</script>

