{% doc %}
  @prompt
    custom video section with opacity option and text iveerlay with heading, subheading and CTA, I should be able to upload video
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
    padding-top: {{ block.settings.padding_top }}px;
    padding-right: 0;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: 0;
    margin: 0;
  }

  .ai-video-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.video_height_desktop }}px;
    overflow: hidden;
    margin: 0;
    border-radius: {{ block.settings.video_border_radius }}px;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-video-wrapper-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-video-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    padding: 40px 20px;
    z-index: 2;
  }

  .ai-video-text-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    max-width: {{ block.settings.content_max_width }}px;
  }

  .ai-video-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-video-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    line-height: 1.5;
  }

  .ai-video-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-video-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  /* Tablet and medium screens (750px - 1023px) */
  @media screen and (min-width: 750px) and (max-width: 1023px) {
    .ai-video-container-{{ ai_gen_id }} {
      height: calc({{ block.settings.video_height_desktop }}px * 0.85);
    }

    .ai-video-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-video-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-video-content-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-video-text-wrapper-{{ ai_gen_id }} {
      max-width: calc({{ block.settings.content_max_width }}px * 0.9);
    }
  }

  /* Mobile screens (max-width: 749px) */
  @media screen and (max-width: 749px) {
    .ai-video-section-{{ ai_gen_id }} {
      {% if block.settings.enable_auto_margin_mobile %}
        margin-right: auto;
        margin-left: auto;
      {% else %}
        margin-right: {{ block.settings.margin_right_mobile }}px;
        margin-left: {{ block.settings.margin_left_mobile }}px;
      {% endif %}
    }

    .ai-video-container-{{ ai_gen_id }} {
      height: {{ block.settings.video_height_mobile }}px;
      min-height: 400px;
    }

    .ai-video-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-video-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-video-content-{{ ai_gen_id }} {
      padding: 20px 15px;
    }

    .ai-video-text-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
      padding: 0 10px;
    }

    .ai-video-cta-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
      padding: calc({{ block.settings.button_padding_vertical }}px * 0.85) calc({{ block.settings.button_padding_horizontal }}px * 0.85);
    }
  }

  /* Extra small mobile (max-width: 480px) */
  @media screen and (max-width: 480px) {
    .ai-video-container-{{ ai_gen_id }} {
      min-height: 350px;
    }

    .ai-video-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size_mobile }}px * 0.9);
    }

    .ai-video-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size_mobile }}px * 0.9);
    }

    .ai-video-content-{{ ai_gen_id }} {
      padding: 15px 10px;
    }
  }

{% endstyle %}

<video-section-{{ ai_gen_id }}
  class="ai-video-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-container-{{ ai_gen_id }}">
    <div class="ai-video-wrapper-{{ ai_gen_id }}">
      {% if block.settings.video_shopify != blank %}
        <video
          autoplay
          muted
          loop
          playsinline
          {% if block.settings.enable_sound %}
            controls
          {% endif %}
        >
          {% for source in block.settings.video_shopify.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
          Your browser does not support the video tag.
        </video>
      {% elsif block.settings.video_url != blank %}
        <video
          autoplay
          muted
          loop
          playsinline
          {% if block.settings.enable_sound %}
            controls
          {% endif %}
        >
          <source src="{{ block.settings.video_url }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      {% else %}
        <div class="ai-video-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-video-empty-state-{{ ai_gen_id }}">
            Next, upload a video or add a video URL
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-video-overlay-{{ ai_gen_id }}"></div>

    <div class="ai-video-content-{{ ai_gen_id }}">
      <div class="ai-video-text-wrapper-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h1 class="ai-video-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <div class="ai-video-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a href="{{ block.settings.button_link | default: '#' }}" class="ai-video-cta-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</video-section-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.video = this.querySelector('video');
        if (this.video) {
          this.video.addEventListener('loadedmetadata', () => {
            this.video.play().catch(() => {});
          });
        }
      }
    }

    customElements.define('video-section-{{ ai_gen_id }}', VideoSection{{ ai_gen_id }});
  })();
</script>

