{% comment %} Related Searches Section for Product Pages - Shows Related Products as Pills {% endcomment %}

{% if section.settings.show_related_searches %}
  {%- liquid
    assign related_products_str = ''
    assign related_count = 0
    assign max_related = section.settings.max_tags | default: 9
    assign current_handle = product.handle

    comment
      Collect related products from the same collections this product belongs to
    endcomment
    for col in product.collections
      if related_count >= max_related
        break
      endif
      if col.handle != 'all' and col.handle != 'frontpage'
        for item in col.products limit: 20
          if related_count >= max_related
            break
          endif
          if item.handle != current_handle
            assign check_handle = '|' | append: item.handle | append: '|'
            assign check_list = '|' | append: related_products_str | append: '|'
            unless check_list contains check_handle
              if related_products_str == ''
                assign related_products_str = item.handle
              else
                assign related_products_str = related_products_str | append: '|' | append: item.handle
              endif
              assign related_count = related_count | plus: 1
            endunless
          endif
        endfor
      endif
    endfor

    assign related_product_handles = related_products_str | split: '|'
  -%}

  {%- liquid
    assign rs_heading = section.settings.heading | default: 'People Also Searched For'
    assign rs_section_bg = section.settings.section_bg_color | default: '#FFFFFF'
    assign rs_pad_top = section.settings.padding_top | default: 30
    assign rs_pad_bottom = section.settings.padding_bottom | default: 30
    assign rs_title_clr = section.settings.title_color | default: '#333333'
    assign rs_title_fs = section.settings.title_font_size | default: 22
    assign rs_tag_bg = section.settings.tag_bg_color | default: '#EFEFEF'
    assign rs_tag_clr = section.settings.tag_text_color | default: '#333333'
    assign rs_tag_hover_bg = section.settings.tag_hover_bg_color | default: '#DDDDDD'
    assign rs_tag_hover_clr = section.settings.tag_hover_text_color | default: '#DB1E37'
    assign rs_tag_fs = section.settings.tag_font_size | default: 14
    assign rs_tag_br = section.settings.tag_border_radius | default: 20
    assign rs_tag_pv = section.settings.tag_padding_vertical | default: 10
    assign rs_tag_ph = section.settings.tag_padding_horizontal | default: 18
    assign rs_gap = section.settings.tag_gap | default: 10
    assign rs_title_fs_mobile = rs_title_fs | minus: 4
    assign rs_tag_fs_mobile = rs_tag_fs | minus: 1
    assign rs_tag_pv_mobile = rs_tag_pv | minus: 2
    assign rs_tag_ph_mobile = rs_tag_ph | minus: 4
    assign rs_gap_mobile = rs_gap | minus: 2
  -%}

  {% if related_product_handles.size > 0 %}
    <div class="related-searches-pills" style="
      background-color: {{ rs_section_bg }};
      padding-top: {{ rs_pad_top }}px;
      padding-bottom: {{ rs_pad_bottom }}px;
    ">
      <div class="related-searches-pills__container">
        <h3 class="related-searches-pills__title" style="
          color: {{ rs_title_clr }};
          font-size: {{ rs_title_fs }}px;
        ">
          {{ rs_heading }}
        </h3>
        <div class="related-searches-pills__tags">
          {% for handle in related_product_handles %}
            {% assign rel_prod = all_products[handle] %}
            {% if rel_prod and rel_prod.title != blank %}
              <a href="{{ rel_prod.url }}" class="related-searches-pills__tag" style="
                background-color: {{ rs_tag_bg }};
                color: {{ rs_tag_clr }};
                font-size: {{ rs_tag_fs }}px;
                border-radius: {{ rs_tag_br }}px;
              ">
                {{ rel_prod.title | truncate: section.settings.title_max_length, '...' }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <style>
      .related-searches-pills {
        width: 100%;
      }
      .related-searches-pills__container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px;
      }
      .related-searches-pills__title {
        font-weight: 400;
        margin: 0 0 20px 0;
        text-transform: none;
        letter-spacing: 0;
        line-height: 1.3;
      }
      .related-searches-pills__tags {
        display: flex;
        flex-wrap: wrap;
        gap: {{ rs_gap }}px;
      }
      .related-searches-pills__tag {
        display: inline-block;
        padding: {{ rs_tag_pv }}px {{ rs_tag_ph }}px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
        white-space: nowrap;
        line-height: 1.4;
      }
      .related-searches-pills__tag:hover {
        background-color: {{ rs_tag_hover_bg }} !important;
        color: {{ rs_tag_hover_clr }} !important;
        text-decoration: none;
      }
      @media (max-width: 768px) {
        .related-searches-pills__container {
          padding: 0 15px;
        }
        .related-searches-pills__title {
          font-size: {{ rs_title_fs_mobile }}px !important;
          margin-bottom: 15px;
        }
        .related-searches-pills__tags {
          gap: {{ rs_gap_mobile }}px;
        }
        .related-searches-pills__tag {
          font-size: {{ rs_tag_fs_mobile }}px !important;
          padding: {{ rs_tag_pv_mobile }}px {{ rs_tag_ph_mobile }}px;
        }
      }
    </style>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Product Related Searches",
  "class": "product-related-searches--section",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "checkbox",
      "id": "show_related_searches",
      "label": "Show related searches",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "People Also Searched For"
    },
    {
      "type": "range",
      "id": "max_tags",
      "min": 5,
      "max": 30,
      "step": 1,
      "label": "Maximum products to show",
      "default": 9
    },
    {
      "type": "range",
      "id": "title_max_length",
      "min": 15,
      "max": 80,
      "step": 5,
      "label": "Product title max characters",
      "default": 35
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 30
    },
    {
      "type": "header",
      "content": "Title Styling"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title font size",
      "default": 22
    },
    {
      "type": "header",
      "content": "Tag Styling"
    },
    {
      "type": "color",
      "id": "tag_bg_color",
      "label": "Tag background color",
      "default": "#EFEFEF"
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "tag_hover_bg_color",
      "label": "Tag hover background",
      "default": "#DB1E37"
    },
    {
      "type": "color",
      "id": "tag_hover_text_color",
      "label": "Tag hover text color",
      "default": "#DB1E37"
    },
    {
      "type": "range",
      "id": "tag_font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tag font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "tag_border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Tag border radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "tag_padding_vertical",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tag vertical padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "tag_padding_horizontal",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Tag horizontal padding",
      "default": 18
    },
    {
      "type": "range",
      "id": "tag_gap",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Gap between tags",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Product Related Searches"
    }
  ]
}
{% endschema %}
