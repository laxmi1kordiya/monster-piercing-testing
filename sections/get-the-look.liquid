<script>
(function() {
  function initGetTheLook() {
    // Desktop Tab functionality
    var sectionEl = document.getElementById('get-the-look-{{ section.id }}');
    if (!sectionEl) return;

    var tabButtons = sectionEl.querySelectorAll('.get-the-look__tab-button');
    var tabPanels = sectionEl.querySelectorAll('.get-the-look__panel');

    tabButtons.forEach(function(button) {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = this.getAttribute('data-tab-target');

        tabButtons.forEach(function(btn) {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });
        this.classList.add('active');
        this.setAttribute('aria-selected', 'true');

        tabPanels.forEach(function(panel) {
          panel.classList.remove('active');
        });
        var targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });

    // Desktop Slider navigation
    var sliderContainers = document.querySelectorAll('#shopify-section-{{ section.id }} .get-the-look__slider-container');
    sliderContainers.forEach(function(container) {
      var slider = container.querySelector('[data-slider]');
      var prevBtn = container.querySelector('.get-the-look__slider-nav--prev');
      var nextBtn = container.querySelector('.get-the-look__slider-nav--next');
      
      if (!slider) return;

      var scrollAmount = {{ section.settings.product_card_width | plus: 15 }};

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      }
    });

    // Modal Open
    var modalOpenBtns = document.querySelectorAll('.js-gtl-modal-open');
    modalOpenBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var modalId = this.getAttribute('data-modal-id');
        var modal = document.getElementById(modalId);
        if (modal) {
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    // Modal Close
    var modalCloseBtns = document.querySelectorAll('.js-gtl-modal-close');
    modalCloseBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var modal = this.closest('.get-the-look__modal');
        if (modal) {
          modal.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        var activeModals = document.querySelectorAll('.get-the-look__modal.active');
        activeModals.forEach(function(modal) {
          modal.classList.remove('active');
        });
        document.body.style.overflow = '';
      }
    });

  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGetTheLook);
  } else {
    initGetTheLook();
  }

  // Reinitialize on Shopify section reload (for theme editor)
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target.querySelector('.get-the-look')) {
      initGetTheLook();
    }
  });

  // Add to Cart functionality - Use event delegation to prevent duplicate handlers
  var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
  if (sectionEl && !sectionEl._gtlAddToCartBound) {
    sectionEl._gtlAddToCartBound = true;
    sectionEl.addEventListener('click', function(e) {
      var button = e.target.closest('.get-the-look__add-to-cart');
      if (!button) return;

      e.preventDefault();
      e.stopPropagation();

      var variantId = button.getAttribute('data-variant-id');
      var isModal = button.classList.contains('get-the-look__add-to-cart--modal');
      var originalText = isModal ? 'Add' : 'Add to Cart';

      if (!variantId || button.classList.contains('is-loading')) return;

      button.classList.add('is-loading');
      button.textContent = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      })
      .then(function(response) {
        if (!response.ok) throw new Error('Add to cart failed');
        return response.json();
      })
      .then(function(data) {
        button.classList.remove('is-loading');
        button.classList.add('is-added');
        button.textContent = 'Added!';

        // Close any open Get the Look modal first
        var activeModals = document.querySelectorAll('.get-the-look__modal.active');
        activeModals.forEach(function(modal) {
          modal.classList.remove('active');
        });
        document.body.style.overflow = '';

        // Update cart count by fetching cart data
        fetch('/cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            var count = cart.item_count || 0;
            var countSelectors = [
              '[data-header-cart-count]',
              '[data-cart-count]',
              '[data-cart-bubble]',
              '[data-cart-quantity]',
              '.site-header-cart--count',
              '.site-header__cart-count',
              '.site-cart-count',
              '.cart-count-bubble',
              '.cart-count',
              '.cart-quantity',
              '.header-cart-count',
              '.site-header-cart-badge',
              '.cart-bubble',
              '.mini-cart__count',
              '.cart-badge'
            ];
            countSelectors.forEach(function(sel) {
              document.querySelectorAll(sel).forEach(function(el) {
                el.textContent = count > 0 ? String(count) : '';
                if (count > 0) el.classList.add('visible');
                else el.classList.remove('visible');
              });
            });
          });

        // Refresh and open the cart drawer - properly replace the element
        fetch('/?section_id=cart-drawer')
          .then(function(res) { return res.text(); })
          .then(function(html) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var newDrawer = doc.getElementById('CartDrawer');
            var oldDrawer = document.getElementById('CartDrawer');

            if (newDrawer && oldDrawer && oldDrawer.parentNode) {
              // Replace the entire element to preserve proper structure
              oldDrawer.parentNode.replaceChild(newDrawer, oldDrawer);
            }

            // Get fresh references after DOM replacement
            var cartDrawer = document.getElementById('CartDrawer');
            var cartOverlay = document.getElementById('CartDrawerOverlay');

            // Ensure overlay exists
            if (!cartOverlay) {
              cartOverlay = document.createElement('div');
              cartOverlay.id = 'CartDrawerOverlay';
              cartOverlay.className = 'cart-drawer__overlay';
              document.body.appendChild(cartOverlay);
            }

            // Open the cart drawer
            if (cartDrawer) {
              cartDrawer.classList.add('cart-drawer--open');
              document.documentElement.style.overflow = 'hidden';
            }

            // Show overlay with proper styles
            if (cartOverlay) {
              Object.assign(cartOverlay.style, {
                position: 'fixed',
                top: '0',
                left: '0',
                right: '0',
                bottom: '0',
                width: '100%',
                height: '100%',
                zIndex: '9998',
                display: 'block',
                pointerEvents: 'auto',
                opacity: '1',
                visibility: 'visible',
                background: 'rgba(0,0,0,0.36)'
              });
            }

            // Bind close handlers for the new drawer
            var closeDrawerFn = function() {
              var drawer = document.getElementById('CartDrawer');
              var overlay = document.getElementById('CartDrawerOverlay');
              if (drawer) drawer.classList.remove('cart-drawer--open');
              if (overlay) {
                overlay.style.display = 'none';
                overlay.style.pointerEvents = 'none';
                overlay.style.opacity = '0';
                overlay.style.visibility = 'hidden';
              }
              document.documentElement.style.overflow = '';
            };

            // Bind close buttons
            if (cartDrawer) {
              var closeButtons = cartDrawer.querySelectorAll('[data-cart-drawer-close]');
              closeButtons.forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                  e.preventDefault();
                  closeDrawerFn();
                });
              });
            }

            // Bind overlay click
            if (cartOverlay && !cartOverlay._gtlBound) {
              cartOverlay._gtlBound = true;
              cartOverlay.addEventListener('click', function(e) {
                e.preventDefault();
                closeDrawerFn();
              });
            }

            // Bind quantity buttons
            if (cartDrawer) {
              cartDrawer.querySelectorAll('[data-qty-change]').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                  e.preventDefault();
                  var line = btn.getAttribute('data-line');
                  var change = btn.getAttribute('data-qty-change');
                  var input = cartDrawer.querySelector('[data-line-input="' + line + '"]');
                  var qty = parseInt(input ? input.value : '0', 10) || 0;
                  qty = change === 'increase' ? qty + 1 : qty - 1;
                  if (qty < 0) qty = 0;

                  var params = new URLSearchParams();
                  params.append('line', String(line));
                  params.append('quantity', String(qty));

                  fetch('/cart/change.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: params.toString()
                  })
                  .then(function() {
                    // Refresh the page section to update drawer
                    location.reload();
                  });
                });
              });
            }
          });

        // Reset button after delay
        setTimeout(function() {
          button.classList.remove('is-added');
          button.textContent = originalText;
        }, 2000);
      })
      .catch(function(error) {
        console.error('Error:', error);
        button.classList.remove('is-loading');
        button.textContent = originalText;
      });
    });
  }
})();
</script>

