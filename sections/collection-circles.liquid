<style>
  .collection-circles__container {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_bg_color }};
    min-height: {{ section.settings.section_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .collection-circles__wrapper {
    display: flex;
    flex-wrap: nowrap;
    justify-content: {{ section.settings.circles_alignment }};
    align-items: center;
    gap: {{ section.settings.circles_gap }}px;
    overflow-x: auto;
    padding: 20px 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  .collection-circles__wrapper::-webkit-scrollbar {
    display: none;
  }

  .collection-circle-item {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }

  .collection-circle {
    flex-shrink: 0;
    width: {{ section.settings.circle_size }}px;
    height: {{ section.settings.circle_size }}px;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Border with gradient support */
  .collection-circle::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: {{ section.settings.border_width }}px;
    {% if section.settings.enable_gradient_border %}
      background: linear-gradient(
        {{ section.settings.gradient_angle }}deg,
        {{ section.settings.border_color_start }},
        {{ section.settings.border_color_end }}
      );
    {% else %}
      background: {{ section.settings.border_color_start }};
    {% endif %}
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 2;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .collection-circle__image-wrapper {
    width: calc(100% - {{ section.settings.border_width | times: 2 }}px);
    height: calc(100% - {{ section.settings.border_width | times: 2 }}px);
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    z-index: 1;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .collection-circle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Bottom shade overlay - Desktop only */
  .collection-circle__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 65%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.7) 40%, rgba(0, 0, 0, 0.3) 70%, transparent 100%);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    z-index: 2;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Desktop title - inside circle on hover */
  .collection-circle__title {
    position: absolute;
    bottom: 15%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    padding: 8px 12px;
    text-align: center;
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    z-index: 3;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    max-width: 85%;
    word-wrap: break-word;
    line-height: 1.2;
  }

  /* Mobile title - below circle */
  .collection-circle__title-mobile {
    display: none;
  }

  /* Hover Effects - Desktop */
  .collection-circle:hover .collection-circle__image-wrapper {
    {% if section.settings.hover_effect == 'zoom_image' %}
      transform: scale(1.1);
    {% elsif section.settings.hover_effect == 'blur_image' %}
      filter: blur(3px);
    {% endif %}
  }

  .collection-circle:hover .collection-circle__image {
    {% if section.settings.hover_effect == 'zoom_image' %}
      transform: scale(1.15);
    {% endif %}
  }

  .collection-circle:hover::before {
    {% if section.settings.enable_hover_gradient_border %}
      background: linear-gradient(
        {{ section.settings.hover_gradient_angle }}deg,
        {{ section.settings.hover_border_color_start }},
        {{ section.settings.hover_border_color_end }}
      );
    {% else %}
      background: {{ section.settings.hover_border_color_start }};
    {% endif %}
    {% if section.settings.hover_border_width_increase > 0 %}
      padding: {{ section.settings.border_width | plus: section.settings.hover_border_width_increase }}px;
    {% endif %}
  }

  .collection-circle:hover .collection-circle__overlay {
    opacity: 1;
  }

  .collection-circle:hover .collection-circle__title {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Placeholder SVG */
  .collection-circle .placeholder-svg {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
  }

  /* Mobile Responsive */
  @media only screen and (max-width: 768px) {
    .collection-circles__container {
      min-height: {{ section.settings.section_height_mobile }}px;
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    .collection-circle {
      width: {{ section.settings.circle_size_mobile }}px;
      height: {{ section.settings.circle_size_mobile }}px;
    }

    .collection-circles__wrapper {
      gap: {{ section.settings.circles_gap_mobile }}px;
      justify-content: flex-start;
      padding-left: 15px;
      padding-right: 15px;
      scroll-snap-type: x mandatory;
    }

    .collection-circle-item {
      scroll-snap-align: center;
    }

    /* Hide overlay and inside title on mobile */
    .collection-circle__overlay,
    .collection-circle__title {
      display: none !important;
    }

    /* Show title below circle on mobile */
    .collection-circle__title-mobile {
      display: block;
      margin-top: 8px;
      text-align: center;
      font-size: {{ section.settings.title_font_size_mobile }}px;
      font-weight: {{ section.settings.title_font_weight }};
      color: {{ section.settings.title_color_mobile }};
      max-width: {{ section.settings.circle_size_mobile }}px;
      word-wrap: break-word;
      line-height: 1.2;
    }

    /* Disable hover effects on mobile */
    .collection-circle:hover .collection-circle__image-wrapper {
      transform: none;
      filter: none;
    }

    .collection-circle:hover .collection-circle__image {
      transform: none;
    }
  }
</style>

<section class="collection-circles__container">
  {% if section.blocks.size > 0 %}
    <div class="collection-circles__wrapper">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        {% assign circle_link = block.settings.custom_link | default: collection.url %}
        {% assign circle_title = block.settings.custom_title | default: collection.title %}
        {% assign circle_image = block.settings.image | default: collection.image %}

        <a
          href="{{ circle_link }}"
          class="collection-circle-item"
          {{ block.shopify_attributes }}
          {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          <div class="collection-circle">
            <div class="collection-circle__image-wrapper">
              {% if circle_image %}
                <img
                  class="collection-circle__image"
                  src="{{ circle_image | image_url: width: 400 }}"
                  alt="{{ circle_title | escape }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-circle__image placeholder-svg' }}
              {% endif %}
            </div>
            <div class="collection-circle__overlay"></div>
            {% if section.settings.show_title and circle_title != blank %}
              <span class="collection-circle__title">{{ circle_title | escape }}</span>
            {% endif %}
          </div>
          {% if section.settings.show_title and circle_title != blank %}
            <span class="collection-circle__title-mobile">{{ circle_title | escape }}</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="collection-circles__wrapper">
      <p style="text-align: center; width: 100%; color: #999;">Add collection circles using the "Add block" button</p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Collection Circles",
  "settings": [
    {
      "type": "header",
      "content": "Section Height"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height (Desktop)",
      "min": 50,
      "max": 800,
      "step": 10,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Section Height (Mobile)",
      "min": 50,
      "max": 600,
      "step": 10,
      "default": 200,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Circle Settings"
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Circle Size (Desktop)",
      "min": 40,
      "max": 400,
      "step": 5,
      "default": 150,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "circle_size_mobile",
      "label": "Circle Size (Mobile)",
      "min": 30,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "circles_gap",
      "label": "Gap Between Circles (Desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "circles_gap_mobile",
      "label": "Gap Between Circles (Mobile)",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "circles_alignment",
      "label": "Circles Alignment (Desktop)",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space Between" },
        { "value": "space-around", "label": "Space Around" },
        { "value": "space-evenly", "label": "Space Evenly" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Border Settings"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_border",
      "label": "Enable Gradient Border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color_start",
      "label": "Border Color (Start/Solid)",
      "default": "#db1e37"
    },
    {
      "type": "color",
      "id": "border_color_end",
      "label": "Border Color (End - Gradient)",
      "default": "#ff6b6b"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient Angle",
      "min": 0,
      "max": 360,
      "step": 15,
      "default": 135,
      "unit": "deg"
    },
    {
      "type": "header",
      "content": "Hover Effects (Desktop Only)"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover Effect",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "zoom_image", "label": "Zoom Image" },
        { "value": "blur_image", "label": "Blur Image" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "hover_border_width_increase",
      "label": "Border Width Increase on Hover",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 2,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_gradient_border",
      "label": "Enable Gradient Border on Hover",
      "default": true
    },
    {
      "type": "color",
      "id": "hover_border_color_start",
      "label": "Hover Border Color (Start/Solid)",
      "default": "#ff6b6b"
    },
    {
      "type": "color",
      "id": "hover_border_color_end",
      "label": "Hover Border Color (End - Gradient)",
      "default": "#db1e37"
    },
    {
      "type": "range",
      "id": "hover_gradient_angle",
      "label": "Hover Gradient Angle",
      "min": 0,
      "max": 360,
      "step": 15,
      "default": 315,
      "unit": "deg"
    },
    {
      "type": "header",
      "content": "Title Settings"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show Collection Title",
      "default": true
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size (Desktop)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Title Font Size (Mobile)",
      "min": 8,
      "max": 20,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color (Desktop - on hover)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color_mobile",
      "label": "Title Color (Mobile - below circle)",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "circle",
      "name": "Collection Circle",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Leave blank to use collection image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link",
          "info": "Leave blank to use collection URL"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open Link in New Tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Circles",
      "blocks": []
    }
  ]
}
{% endschema %}
