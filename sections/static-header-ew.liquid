{% assign has_box_shadow = false %}
{% if settings.color_background == settings.color_header_background  %}
  {% assign has_box_shadow = true %}
{% endif %}

<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="static-header"
  data-section-data>
  {
    "settings": {
      "sticky_header": {{ section.settings.sticky_header | json }},
      "hide_on_scroll_down": {{ section.settings.hide_on_scroll_down | json }},
      "has_box_shadow": {{ has_box_shadow | json }},
      "live_search": {
        "enable": {{ section.settings.enable_live_search | json }},
        "enable_images": {{ section.settings.enable_live_search_images | json }},
        "enable_content": {{ section.settings.enable_live_search_articles_pages | json }},
        "money_format": {{ shop.money_format | strip_html | json }},
        "show_mobile_search_bar": {{ section.settings.show_mobile_search_bar | json }},
        "context": {
          "view_all_results": {{ 'search.general.view_all_results' | t | json }},
          "view_all_products": {{ 'search.general.view_all_products' | t | json }},
          "content_results": {
            "title": {{ 'search.general.pages_and_posts_title' | t | json }},
            "no_results": {{ 'search.general.pages_and_posts_no_results' | t | json }}
          },
          "no_results_products": {
            "title": {{ 'search.general.no_results_products_title' | t: terms: '*terms*' | json }},
            "title_in_category": {{ 'search.general.no_results_products_title_in_category' | t: terms: '*terms*', category: '*category*' | json }},
            "message": {{ 'search.general.no_results_products_message' | t | json }}
          }
        }
      }
    }
  }
</script>

{%- assign logo_height = section.settings.logo_height | default: 100 -%}
{%- assign logo_width = section.settings.logo_width | default: 200 -%}
{%- assign logo_size = logo_width | prepend: 'x' -%}
{{ 'static-header-ew.css' | asset_url | stylesheet_tag }}
{{ 'meganav-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .site-header {
    --layout-container-max-width: {{ settings.layout_max_width }}px;
  }
  .site-header.static-header-ew {
    background-color: #000 !important;
    box-shadow: none !important;
    border: none !important;
  }
  .static-header-ew .site-header-main--wrapper {
    background-color: #000 !important;
    box-shadow: none !important;
    border: none !important;
  }
  .static-header-ew .site-header-main {
    background-color: #000 !important;
    box-shadow: none !important;
    border: none !important;
    color: #fff;
  }
  .static-header-ew .site-header-main--wrapper *,
  .static-header-ew .site-header-main * {
    color: #fff;
  }
  .static-header-ew .site-header-main--wrapper svg,
  .static-header-ew .site-header-main svg {
    fill: #fff;
  }
  .site-logo {
    max-width: {{ logo_width }}px;
  }
  .site-logo-image {
    max-height: {{ logo_height }}px;
  }

  /* Header Center Navigation Styles */
  .site-header-center .site-navigation {
    background-color: transparent;
    justify-content: center;
  }

  /* .site-header-center .site-navigation .navmenu-link-depth-1 {
    color: #000;
    padding: 10px 12px;
  } */

  .site-header-center .site-navigation .navmenu-depth-1 > li {
    padding-top: 0;
    padding-bottom: 0;
  }

  .site-header-center li.navmenu-item {
    position: relative;
  }

  .site-header-center li.navmenu-item:after {
    display: none;
  }

  .site-header-center li.navmenu-item a,
  .site-header-center li.navmenu-item summary {
    position: relative;
    z-index: 1;
    opacity: 1;
  }

  .site-header-center .site-navigation .navmenu-depth-1 > li > a:hover,
  .site-header-center .site-navigation .navmenu-depth-1 > li > summary:hover,
  .site-header-center .site-navigation .navmenu-depth-1 > li > a[aria-expanded=true] {
    opacity: 0.7;
  }

  /* Smaller header and proper alignment */
  @media screen and (min-width: 1024px) {
    .static-header-ew .site-header-main {
      display: flex !important;
      align-items: center !important;
      padding: 5px 0 !important;
    }

    .static-header-ew .site-header-left {
      display: flex !important;
      align-items: center !important;
      padding: 8px 20px !important;
    }

    .static-header-ew .site-header-center {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      flex: 1 !important;
    }

    .static-header-ew .site-header-nav-wrapper {
      display: flex !important;
      align-items: center !important;
    }

    .static-header-ew .site-header-nav-inner {
      display: flex !important;
      align-items: center !important;
    }

    .static-header-ew .site-header-right {
      display: flex !important;
      align-items: center !important;
      padding: 8px 20px !important;
    }

    .static-header-ew .site-navigation {
      display: flex !important;
      align-items: center !important;
    }

    .static-header-ew .site-navigation .navmenu-depth-1 {
      display: flex !important;
      align-items: center !important;
      height: auto !important;
      margin: 0 !important;
    }

    .static-header-ew .site-navigation .navmenu-depth-1 > li {
      display: flex !important;
      align-items: center !important;
      padding-top: 0 !important;
      height: auto !important;
    }

    /* Smaller logo */
    .static-header-ew .site-logo-image {
      max-height: 50px !important;
    }
  }
{%- endstyle -%}


<header class="site-header site-header-nav--open static-header-ew" role="banner" data-site-header>
  <div class="site-header-main--wrapper">
    <div class="site-header-main site-header--full-width" data-site-header-main data-site-header-mobile-search-button style="display:flex;align-items:center;">
      <div class="site-header-left" style="display:flex;align-items:center;">
        {% comment %} <button class="site-header-menu-toggle" data-menu-toggle>
          <div class="site-header-menu-toggle--button" tabindex="-1">
            <span class="toggle-icon--bar toggle-icon--bar-top"></span>
            <span class="toggle-icon--bar toggle-icon--bar-middle"></span>
            <span class="toggle-icon--bar toggle-icon--bar-bottom"></span>
            <span class="visually-hidden">{{ 'general.accessibility.menu' | t }}</span>
          </div>
        </button> {% endcomment %}
        <div class="site-header-logo">
          <a class="site-logo" href="{{ routes.root_url }}">
            {%- if section.settings.logo -%}
              {%- assign logo_alt = section.settings.logo.alt -%}
              {%- if logo_alt == blank -%}
                {%- assign logo_alt = shop.name | strip -%}
              {%- endif -%}
              {%-
                render 'rimg',
                img: section.settings.logo,
                class: 'site-logo-image',
                alt: logo_alt,
                size: logo_size,
                focal_point: section.settings.logo.presentation.focal_point,
              -%}
            {%- else -%}
              {%- if template == 'index' -%}
                <h1 class="site-logo-text">
                  {{ shop.name }}
                </h1>
              {%- else -%}
                <span class="site-logo-text">
                  {{ shop.name }}
                </span>
              {%- endif -%}
            {%- endif -%}
          </a>
        </div>
      </div>

      <div class="site-header-center" id="site-header-nav" style="display:flex;align-items:center;justify-content:center;flex:1;">
        <nav class="site-navigation" aria-label="{{ 'general.accessibility.nav_main' | t }}" style="display:flex;align-items:center;">
          {%
            render 'navmenu',
            menu: section.settings.menu,
            blocks: section.blocks,
          %}
        </nav>
      </div>
      <!-- Hidden element for JS sticky header -->
      <div data-site-navigation style="display:none;"></div>

      <div class="site-header-right" style="display:flex;align-items:center;">
        <button class="site-header-search-button" data-asset="search-button">
          <div class="site-header-search-button--icon" tabindex="-1">
            {%- render 'icon-search' -%}
          </div>
        </button>
      </div>
    </div>
  </div>

  {% comment %} {%- render 'site-mobile-nav', blocks: section.blocks, -%} {% endcomment %}
  <search-modal class="auto-search-modal">
      <div class="modal-1" aria-label="modal window">
          <div class="modal-inner" data-search-modal-inner>
              <div class="modal-content" data-search-modal-content>
                <div class="modal-content__wrapper">
                  <div class="live-search-form__wrapper">
                    {%-
                        render 'live-search-form',
                        quick_links: linklists[section.settings.quick_links],
                        enable_images: section.settings.enable_live_search_images,
                        enable_content: section.settings.enable_live_search_articles_pages
                    -%}
                    <button
                      class="modal-close"
                      type="button"
                      aria-label="{{ 'general.accessibility.close' | t }}"
                      data-asset="search-modal-close"
                    >
                      {%- render 'icon-menu-close' -%}
                    </button>
                  </div>
                </div>
              </div>
          </div>
      </div>
  </search-modal>

</header>

<script>
  (function() {
  const navItems = document.querySelectorAll('.static-header-ew .navmenu-item-parent');
  
  navItems.forEach(function(item) {
    const details = item.querySelector('details');
    if (!details) return;
    
    let closeTimeout;
    
    // Open on hover
    item.addEventListener('mouseenter', function() {
      clearTimeout(closeTimeout);
      details.setAttribute('open', '');
    });
    
    // Close with delay on mouse leave
    item.addEventListener('mouseleave', function() {
      closeTimeout = setTimeout(function() {
        details.removeAttribute('open');
      }, 150); // 150ms delay to allow moving to submenu
    });
    
    // Keep open when hovering dropdown
    details.addEventListener('mouseenter', function() {
      clearTimeout(closeTimeout);
    });
    
    // Make summary link clickable to navigate
    const summary = details.querySelector('summary');
    if (summary) {
      summary.addEventListener('click', function(e) {
        const href = summary.getAttribute('data-href');
        if (href && e.target.closest('.navmenu-icon') === null) {
          // If clicking on text (not chevron), navigate
          if (details.hasAttribute('open')) {
            window.location.href = href;
            e.preventDefault();
          }
        }
      });
    }
  });
})();
(function() {
  const header = document.querySelector('.static-header-ew');
  if (!header) return;

  const stickyEnabled = {{ section.settings.sticky_header | json }};
  const hideOnScrollDown = {{ section.settings.hide_on_scroll_down | json }};

  // If sticky is disabled, ensure header is not sticky and exit
  if (!stickyEnabled) {
    header.style.position = 'relative';
    header.style.top = 'auto';
    header.classList.remove('is-sticky');
    return;
  }

  // Get header height for calculations
  const headerHeight = header.offsetHeight;

  // If hide on scroll down is enabled, implement that behavior
  if (hideOnScrollDown) {
    let lastScrollY = window.scrollY;
    let ticking = false;
    let headerVisible = false;

    // Threshold: header must scroll past this before show-on-scroll-up activates
    const scrollThreshold = headerHeight + 50;

    function updateHeader() {
      const currentScrollY = window.scrollY;
      const scrollingUp = currentScrollY < lastScrollY;

      // At top of page - reset everything, header in normal flow
      if (currentScrollY <= 10) {
        header.style.position = 'relative';
        header.style.top = 'auto';
        header.style.transform = 'none';
        header.style.transition = 'none';
        headerVisible = false;
        lastScrollY = currentScrollY;
        ticking = false;
        return;
      }

      // Past threshold and scrolling UP - show fixed header
      if (currentScrollY > scrollThreshold && scrollingUp) {
        if (!headerVisible) {
          header.style.transition = 'none';
          header.style.position = 'fixed';
          header.style.top = '0';
          header.style.left = '0';
          header.style.right = '0';
          header.style.zIndex = '1000';
          header.style.transform = 'translateY(-100%)';
          // Force reflow then animate in
          header.offsetHeight;
          header.style.transition = 'transform 0.3s ease';
          header.style.transform = 'translateY(0)';
          headerVisible = true;
        }
      }

      // Scrolling DOWN while header is visible - hide it
      if (!scrollingUp && headerVisible) {
        header.style.transform = 'translateY(-100%)';
        // After animation, reset to normal flow
        setTimeout(function() {
          if (!headerVisible) return;
          header.style.transition = 'none';
          header.style.position = 'relative';
          header.style.top = 'auto';
          header.style.transform = 'none';
          headerVisible = false;
        }, 300);
        headerVisible = false;
      }

      lastScrollY = currentScrollY;
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
  } else {
    // Sticky enabled but hide on scroll is disabled - always fixed header
    header.style.position = 'fixed';
    header.style.top = '0';
    header.style.left = '0';
    header.style.right = '0';
    header.style.zIndex = '1000';
    header.classList.add('is-sticky');
    document.body.style.paddingTop = headerHeight + 'px';
  }
})();
</script>

