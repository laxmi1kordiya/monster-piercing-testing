{% comment %}
  Shop by Type Section
  Hero image on left with collection tabs and products on right
{% endcomment %}

<section
  class="shop-by-type"
  data-section-id="{{ section.id }}"
  style="
    --sbt-bg-color: {{ section.settings.background_color }};
    --sbt-heading-color: {{ section.settings.heading_color }};
    --sbt-text-color: {{ section.settings.text_color }};
    --sbt-card-bg: {{ section.settings.card_background }};
    --sbt-btn-bg: {{ section.settings.button_background }};
    --sbt-btn-text: {{ section.settings.button_text_color }};
    --sbt-btn-hover-bg: {{ section.settings.button_hover_background }};
    --sbt-tab-bg: {{ section.settings.tab_background }};
    --sbt-tab-text: {{ section.settings.tab_text_color }};
    --sbt-tab-active-bg: {{ section.settings.tab_active_background }};
    --sbt-tab-active-text: {{ section.settings.tab_active_text_color }};
    --sbt-padding-top: {{ section.settings.padding_top }}px;
    --sbt-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="shop-by-type__container">
    <!-- Left: Hero Image -->
    <div class="shop-by-type__hero">
      {% if section.settings.hero_image != blank %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 800 }}"
          srcset="{{ section.settings.hero_image | image_url: width: 400 }} 400w,
                  {{ section.settings.hero_image | image_url: width: 600 }} 600w,
                  {{ section.settings.hero_image | image_url: width: 800 }} 800w,
                  {{ section.settings.hero_image | image_url: width: 1000 }} 1000w"
          sizes="(max-width: 991px) 100vw, 40vw"
          alt="{{ section.settings.hero_image.alt | default: section.settings.heading }}"
          loading="lazy"
          class="shop-by-type__hero-image"
        >
      {% else %}
        <div class="shop-by-type__hero-placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>

    <!-- Right: Content -->
    <div class="shop-by-type__content">
      {% if section.settings.heading != blank %}
        <h2 class="shop-by-type__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="shop-by-type__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {%- comment -%} Build tabs array from settings {%- endcomment -%}
      {%- liquid
        assign tab_collections = ''
        assign tab_count = 0

        if section.settings.tab_1_collection != blank
          assign tab_count = tab_count | plus: 1
        endif
        if section.settings.tab_2_collection != blank
          assign tab_count = tab_count | plus: 1
        endif
        if section.settings.tab_3_collection != blank
          assign tab_count = tab_count | plus: 1
        endif
        if section.settings.tab_4_collection != blank
          assign tab_count = tab_count | plus: 1
        endif
        if section.settings.tab_5_collection != blank
          assign tab_count = tab_count | plus: 1
        endif
      -%}

      {%- comment -%} Check if any More collections are set {%- endcomment -%}
      {%- liquid
        assign has_more_collections = false
        if section.settings.more_collection_1 != blank or section.settings.more_collection_2 != blank or section.settings.more_collection_3 != blank or section.settings.more_collection_4 != blank or section.settings.more_collection_5 != blank or section.settings.more_collection_6 != blank
          assign has_more_collections = true
        endif
      -%}

      {% if tab_count > 0 or has_more_collections %}
        {%- comment -%} Tab Buttons {%- endcomment -%}
        <div class="shop-by-type__tabs">
          {% if section.settings.tab_1_collection != blank %}
            <button class="shop-by-type__tab active" data-tab-index="0">
              {{ section.settings.tab_1_text | default: section.settings.tab_1_collection.title }}
            </button>
          {% endif %}

          {% if section.settings.tab_2_collection != blank %}
            <button class="shop-by-type__tab" data-tab-index="1">
              {{ section.settings.tab_2_text | default: section.settings.tab_2_collection.title }}
            </button>
          {% endif %}

          {% if section.settings.tab_3_collection != blank %}
            <button class="shop-by-type__tab" data-tab-index="2">
              {{ section.settings.tab_3_text | default: section.settings.tab_3_collection.title }}
            </button>
          {% endif %}

          {% if section.settings.tab_4_collection != blank %}
            <button class="shop-by-type__tab" data-tab-index="3">
              {{ section.settings.tab_4_text | default: section.settings.tab_4_collection.title }}
            </button>
          {% endif %}

          {% if section.settings.tab_5_collection != blank %}
            <button class="shop-by-type__tab" data-tab-index="4">
              {{ section.settings.tab_5_text | default: section.settings.tab_5_collection.title }}
            </button>
          {% endif %}

          {%- comment -%} More Button - Always visible {%- endcomment -%}
          <button class="shop-by-type__tab {% if tab_count == 0 %}active{% endif %}" data-tab-index="more">
            {{ section.settings.more_button_text | default: 'More' }}
          </button>
        </div>

        {%- comment -%} Products Grid for each Tab {%- endcomment -%}
        <div class="shop-by-type__carousel-wrapper">
          {%- comment -%} Tab 1 Products {%- endcomment -%}
          {% if section.settings.tab_1_collection != blank %}
            {% assign tab_collection = section.settings.tab_1_collection %}
            {% assign products_limit = section.settings.tab_1_products | default: 6 %}
            <div class="shop-by-type__products-container active" data-products-tab="0">
              <div class="shop-by-type__products-grid">
                {% for product in tab_collection.products limit: products_limit %}
                  {% render 'shop-by-type-product-card', product: product, section: section %}
                {% endfor %}
              </div>
              <a href="{{ tab_collection.url }}" class="shop-by-type__view-more-btn">
                {{ section.settings.view_more_text | default: 'View More' }}
              </a>
            </div>
          {% endif %}

          {%- comment -%} Tab 2 Products {%- endcomment -%}
          {% if section.settings.tab_2_collection != blank %}
            {% assign tab_collection = section.settings.tab_2_collection %}
            {% assign products_limit = section.settings.tab_2_products | default: 6 %}
            <div class="shop-by-type__products-container" data-products-tab="1">
              <div class="shop-by-type__products-grid">
                {% for product in tab_collection.products limit: products_limit %}
                  {% render 'shop-by-type-product-card', product: product, section: section %}
                {% endfor %}
              </div>
              <a href="{{ tab_collection.url }}" class="shop-by-type__view-more-btn">
                {{ section.settings.view_more_text | default: 'View More' }}
              </a>
            </div>
          {% endif %}

          {%- comment -%} Tab 3 Products {%- endcomment -%}
          {% if section.settings.tab_3_collection != blank %}
            {% assign tab_collection = section.settings.tab_3_collection %}
            {% assign products_limit = section.settings.tab_3_products | default: 6 %}
            <div class="shop-by-type__products-container" data-products-tab="2">
              <div class="shop-by-type__products-grid">
                {% for product in tab_collection.products limit: products_limit %}
                  {% render 'shop-by-type-product-card', product: product, section: section %}
                {% endfor %}
              </div>
              <a href="{{ tab_collection.url }}" class="shop-by-type__view-more-btn">
                {{ section.settings.view_more_text | default: 'View More' }}
              </a>
            </div>
          {% endif %}

          {%- comment -%} Tab 4 Products {%- endcomment -%}
          {% if section.settings.tab_4_collection != blank %}
            {% assign tab_collection = section.settings.tab_4_collection %}
            {% assign products_limit = section.settings.tab_4_products | default: 6 %}
            <div class="shop-by-type__products-container" data-products-tab="3">
              <div class="shop-by-type__products-grid">
                {% for product in tab_collection.products limit: products_limit %}
                  {% render 'shop-by-type-product-card', product: product, section: section %}
                {% endfor %}
              </div>
              <a href="{{ tab_collection.url }}" class="shop-by-type__view-more-btn">
                {{ section.settings.view_more_text | default: 'View More' }}
              </a>
            </div>
          {% endif %}

          {%- comment -%} Tab 5 Products {%- endcomment -%}
          {% if section.settings.tab_5_collection != blank %}
            {% assign tab_collection = section.settings.tab_5_collection %}
            {% assign products_limit = section.settings.tab_5_products | default: 6 %}
            <div class="shop-by-type__products-container" data-products-tab="4">
              <div class="shop-by-type__products-grid">
                {% for product in tab_collection.products limit: products_limit %}
                  {% render 'shop-by-type-product-card', product: product, section: section %}
                {% endfor %}
              </div>
              <a href="{{ tab_collection.url }}" class="shop-by-type__view-more-btn">
                {{ section.settings.view_more_text | default: 'View More' }}
              </a>
            </div>
          {% endif %}

          {%- comment -%} More Tab - Collection Grid {%- endcomment -%}
          <div class="shop-by-type__products-container {% if tab_count == 0 %}active{% endif %}" data-products-tab="more">
            <div class="shop-by-type__collection-grid">
              {% if section.settings.more_collection_1 != blank %}
                {% assign coll = section.settings.more_collection_1 %}
                <a href="{{ coll.url }}" class="shop-by-type__collection-card">
                  <div class="shop-by-type__collection-image-wrapper">
                    {% if coll.image %}
                      <img src="{{ coll.image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% elsif coll.products.first.featured_image %}
                      <img src="{{ coll.products.first.featured_image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% else %}
                      <div class="shop-by-type__collection-placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                    {% endif %}
                  </div>
                  <h3 class="shop-by-type__collection-title">{{ coll.title }}</h3>
                </a>
              {% endif %}

              {% if section.settings.more_collection_2 != blank %}
                {% assign coll = section.settings.more_collection_2 %}
                <a href="{{ coll.url }}" class="shop-by-type__collection-card">
                  <div class="shop-by-type__collection-image-wrapper">
                    {% if coll.image %}
                      <img src="{{ coll.image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% elsif coll.products.first.featured_image %}
                      <img src="{{ coll.products.first.featured_image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% else %}
                      <div class="shop-by-type__collection-placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                    {% endif %}
                  </div>
                  <h3 class="shop-by-type__collection-title">{{ coll.title }}</h3>
                </a>
              {% endif %}

              {% if section.settings.more_collection_3 != blank %}
                {% assign coll = section.settings.more_collection_3 %}
                <a href="{{ coll.url }}" class="shop-by-type__collection-card">
                  <div class="shop-by-type__collection-image-wrapper">
                    {% if coll.image %}
                      <img src="{{ coll.image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% elsif coll.products.first.featured_image %}
                      <img src="{{ coll.products.first.featured_image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% else %}
                      <div class="shop-by-type__collection-placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                    {% endif %}
                  </div>
                  <h3 class="shop-by-type__collection-title">{{ coll.title }}</h3>
                </a>
              {% endif %}

              {% if section.settings.more_collection_4 != blank %}
                {% assign coll = section.settings.more_collection_4 %}
                <a href="{{ coll.url }}" class="shop-by-type__collection-card">
                  <div class="shop-by-type__collection-image-wrapper">
                    {% if coll.image %}
                      <img src="{{ coll.image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% elsif coll.products.first.featured_image %}
                      <img src="{{ coll.products.first.featured_image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% else %}
                      <div class="shop-by-type__collection-placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                    {% endif %}
                  </div>
                  <h3 class="shop-by-type__collection-title">{{ coll.title }}</h3>
                </a>
              {% endif %}

              {% if section.settings.more_collection_5 != blank %}
                {% assign coll = section.settings.more_collection_5 %}
                <a href="{{ coll.url }}" class="shop-by-type__collection-card">
                  <div class="shop-by-type__collection-image-wrapper">
                    {% if coll.image %}
                      <img src="{{ coll.image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% elsif coll.products.first.featured_image %}
                      <img src="{{ coll.products.first.featured_image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% else %}
                      <div class="shop-by-type__collection-placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                    {% endif %}
                  </div>
                  <h3 class="shop-by-type__collection-title">{{ coll.title }}</h3>
                </a>
              {% endif %}

              {% if section.settings.more_collection_6 != blank %}
                {% assign coll = section.settings.more_collection_6 %}
                <a href="{{ coll.url }}" class="shop-by-type__collection-card">
                  <div class="shop-by-type__collection-image-wrapper">
                    {% if coll.image %}
                      <img src="{{ coll.image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% elsif coll.products.first.featured_image %}
                      <img src="{{ coll.products.first.featured_image | image_url: width: 300 }}" alt="{{ coll.title }}" loading="eager" class="shop-by-type__collection-image">
                    {% else %}
                      <div class="shop-by-type__collection-placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                    {% endif %}
                  </div>
                  <h3 class="shop-by-type__collection-title">{{ coll.title }}</h3>
                </a>
              {% endif %}
            </div>
            <a href="/collections" class="shop-by-type__view-all-collections-btn">
              {{ section.settings.view_all_collections_text | default: 'View All Collections' }}
            </a>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .shop-by-type {
    padding: var(--sbt-padding-top) 0 var(--sbt-padding-bottom);
    background-color: var(--sbt-bg-color);
    overflow-x: hidden;
    width: 100%;
    max-width: 100vw;
  }

  .shop-by-type__container {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 30px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  .shop-by-type__hero {
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    position: relative;
    height: 100%;
  }

  .shop-by-type__hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }

  .shop-by-type__hero-placeholder {
    width: 100%;
    height: 100%;
    background: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shop-by-type__hero-placeholder .placeholder-svg {
    width: 60%;
    height: auto;
    opacity: 0.5;
  }

  .shop-by-type__content {
    display: flex;
    flex-direction: column;
    padding: 20px 0;
    width: 100%;
    overflow: hidden;
  }

  .shop-by-type__heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 600;
    color: var(--sbt-heading-color);
    margin: 0 0 10px;
    text-align: {{ section.settings.text_alignment }};
  }

  .shop-by-type__subheading {
    font-size: 16px;
    color: var(--sbt-text-color);
    margin: 0 0 20px;
    text-align: {{ section.settings.text_alignment }};
    opacity: 0.8;
  }

  /* Tab Buttons */
  .shop-by-type__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
    justify-content: {{ section.settings.text_alignment }};
  }

  .shop-by-type__tab {
    padding: 10px 20px;
    background: var(--sbt-tab-bg);
    color: var(--sbt-tab-text);
    border: 1px solid var(--sbt-tab-bg);
    border-radius: {{ section.settings.tab_radius }}px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .shop-by-type__tab:hover {
    background: var(--sbt-tab-active-bg);
    color: var(--sbt-tab-active-text);
  }

  .shop-by-type__tab.active {
    background: var(--sbt-tab-active-bg);
    color: var(--sbt-tab-active-text);
    border-color: var(--sbt-tab-active-bg);
  }

  /* Carousel Wrapper */
  .shop-by-type__carousel-wrapper {
    position: relative;
  }

  /* Products Container - Simple show/hide */
  .shop-by-type__products-container {
    display: none;
  }

  .shop-by-type__products-container.active {
    display: block;
  }

  /* Products Grid */
  .shop-by-type__products-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
    align-items: stretch;
  }

  /* View More Button */
  .shop-by-type__products-container.active {
    text-align: center;
  }

  .shop-by-type__products-grid,
  .shop-by-type__collection-grid {
    text-align: left;
  }

  .shop-by-type__view-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 12px 24px;
    background: var(--sbt-btn-bg);
    color: var(--sbt-btn-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border-radius: {{ section.settings.button_radius }}px;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .shop-by-type__view-more-btn:hover {
    background: var(--sbt-btn-hover-bg);
  }

  /* View All Collections Button */
  .shop-by-type__view-all-collections-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    padding: 12px 24px;
    background: var(--sbt-btn-bg);
    color: var(--sbt-btn-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border-radius: {{ section.settings.button_radius }}px;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .shop-by-type__view-all-collections-btn:hover {
    background: var(--sbt-btn-hover-bg);
  }

  /* Product Card & Collection Card - Same Size */
  .shop-by-type__product-card,
  .shop-by-type__collection-card {
    background: var(--sbt-card-bg);
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
  }

  .shop-by-type__product-card:hover,
  .shop-by-type__collection-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .shop-by-type__product-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    height: 100%;
  }

  /* Image Section */
  .shop-by-type__product-image-section {
    width: 100%;
    {% comment %} padding: 12px; {% endcomment %}
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shop-by-type__product-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 8px;
    background: transparent;
  }

  .shop-by-type__product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .shop-by-type__product-placeholder {
    width: 80%;
    height: 80%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Product Details Section */
  .shop-by-type__product-details {
    width: 100%;
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
  }

  .shop-by-type__product-title {
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 500;
    color: var(--sbt-heading-color);
    margin: 0 0 6px;
    text-align: center;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Product Rating */
  .shop-by-type__product-rating {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 6px;
  }

  .shop-by-type__stars {
    display: flex;
    gap: 2px;
  }

  .shop-by-type__stars .star {
    color: #FFB800;
  }

  .shop-by-type__rating-count {
    font-size: 12px;
    color: #666;
  }

  /* Product Price */
  .shop-by-type__product-price {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .shop-by-type__price-compare {
    font-size: 13px;
    color: #999;
    text-decoration: line-through;
  }

  .shop-by-type__price-current {
    font-size: 15px;
    font-weight: 600;
    color: var(--sbt-heading-color);
  }

  .shop-by-type__product-button {
    display: inline-block;
    width: 100%;
    padding: 10px 16px;
    background: var(--sbt-btn-bg);
    color: var(--sbt-btn-text);
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    border-radius: {{ section.settings.button_radius }}px;
    transition: background-color 0.3s ease;
    margin-top: auto;
  }

  .shop-by-type__product-card:hover .shop-by-type__product-button {
    background: var(--sbt-btn-hover-bg);
  }

  /* Carousel wrapper - already defined above */

  /* Collection Grid (More Tab) */
  .shop-by-type__collection-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
    align-items: stretch;
  }

  .shop-by-type__collection-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 15px;
  }

  .shop-by-type__collection-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: 8px;
  }

  .shop-by-type__collection-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-by-type__collection-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0f0f0;
  }

  .shop-by-type__collection-placeholder .placeholder-svg {
    width: 50%;
    height: auto;
    opacity: 0.3;
  }

  .shop-by-type__collection-title {
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 500;
    color: var(--sbt-heading-color);
    margin: 0;
    text-align: center;
  }

  /* Tablet */
  @media screen and (max-width: 991px) {
    .shop-by-type__container {
      grid-template-columns: 1fr;
    }

    .shop-by-type__hero {
      height: 650px;
    }

    .shop-by-type__products-grid,
    .shop-by-type__collection-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Mobile */
  @media screen and (max-width: 600px) {
    .shop-by-type__container {
      padding: 0 15px;
      max-width: 100%;
      overflow: hidden;
    }

    .shop-by-type__hero {
      height: 500px;
    }

    .shop-by-type__tabs {
      overflow-x: auto;
      flex-wrap: nowrap;
      justify-content: flex-start;
      padding-bottom: 10px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .shop-by-type__tabs::-webkit-scrollbar {
      display: none;
    }

    .shop-by-type__tab {
      flex-shrink: 0;
      padding: 8px 16px;
      font-size: 13px;
    }

    .shop-by-type__products-grid,
    .shop-by-type__collection-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 12px;
      padding-bottom: 10px;
    }

    .shop-by-type__products-grid::-webkit-scrollbar,
    .shop-by-type__collection-grid::-webkit-scrollbar {
      display: none;
    }

    .shop-by-type__product-card,
    .shop-by-type__collection-card {
      flex: 0 0 45%;
      min-width: 45%;
      scroll-snap-align: start;
    }

    .shop-by-type__collection-card {
      padding: 10px;
    }

    .shop-by-type__collection-title {
      font-size: 13px;
    }

    .shop-by-type__view-more-btn,
    .shop-by-type__view-all-collections-btn {
      width: auto;
      justify-content: center;
      margin-top: 15px;
      padding: 10px 20px;
      font-size: 13px;
    }

    {% comment %} .shop-by-type__product-image-section {
      padding: 8px;
    } {% endcomment %}

    .shop-by-type__product-details {
      padding: 0 8px 8px;
    }

    .shop-by-type__product-title {
      font-size: 13px;
      margin-bottom: 4px;
    }

    .shop-by-type__product-price {
      margin-bottom: 6px;
    }

    .shop-by-type__product-button {
      padding: 8px 12px;
      font-size: 12px;
    }

    .shop-by-type__content {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const tabs = section.querySelectorAll('.shop-by-type__tab');
    const productContainers = section.querySelectorAll('[data-products-tab]');

    // Simple tab switching - only changes carousel content
    tabs.forEach(tab => {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        const tabIndex = this.getAttribute('data-tab-index');
        const targetContainer = section.querySelector('[data-products-tab="' + tabIndex + '"]');

        // Remove active from all tabs
        tabs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');

        // Remove active from all containers, add to target
        productContainers.forEach(container => container.classList.remove('active'));
        if (targetContainer) {
          targetContainer.classList.add('active');
        }
      });
    });
  });
</script>

