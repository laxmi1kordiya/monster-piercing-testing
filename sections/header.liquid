{%- style -%}
  /* Critical header styles inlined to prevent CLS */
  .static-header-ew .site-header-main--wrapper {
    background-color: #000;
    color: #fff;
    position: sticky;
    z-index: 1001;
    overflow: visible;
    box-shadow: none;
    border: none;
  }
  .static-header-ew .site-header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0;
    position: relative;
    overflow: visible;
    height: 50px;
    background-color: #000;
    box-shadow: none;
    border: none;
  }
  .static-header-ew .site-header-left {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 2px 20px;
  }
  .static-header-ew .site-header-right {
    display: flex;
    align-items: center;
    padding: 2px 20px;
  }
  .static-header-ew .site-header-center {
    flex: 1;
    display: none;
    align-items: center;
  }
  @media screen and (max-width: 1023px) {
    .static-header-ew .site-header-left { padding: 10px 15px; }
    .static-header-ew .site-header-right { padding: 10px 15px; }
    .static-header-ew .site-header-center { display: none; }
  }
  @media screen and (min-width: 1024px) {
    .static-header-ew .site-header-center {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .static-header-ew .site-header-menu-toggle { display: none; }
  }
  /* End critical header styles */

  .site-header {
    --layout-container-max-width: {{ settings.layout_max_width }}px;
  }
  .site-logo {
    max-width: {{ logo_width }}px;
  }
  .site-logo-image {
    max-height: {{ logo_height }}px;
  }
  .site-navigation-wrapper{
    background-color:{{section.settings.menu_background}};
  }
  .site-navigation{
    background-color:transparent;
    justify-content: center;
  }
  .site-navigation .navmenu-link-depth-1{
    color:{{section.settings.menu_text_color}};
    padding: 14px 15px;
  }
  @media screen and (min-width: 1024px){
    .site-header-main-content {
      margin-right:80px;
      margin-left: 0;
    }
  }
  .site-header .site-navigation .navmenu-depth-1>li {
    padding-top: 0;
    padding-bottom: 0;
  }
  .site-header li.navmenu-item{
    position:relative;
  }
 
 .site-header li.navmenu-item a,summary{
    postion:relative;
    z-index:1;
    opacity:1;
  }
  .site-header .site-navigation .navmenu-depth-1>li>a:hover, .site-navigation .navmenu-depth-1>li>a[aria-expanded=true] {
    opacity: 1;
  }
  .site-header .site-navigation .navmenu-depth-2 .navmenu-link:hover, .site-navigation .navmenu-depth-2 .navmenu-link.navmenu-active {
    color: #fff;
    position: relative;
    z-index: 1;
  }

  /* Mega Menu Icon Size - Adjustable from Admin */
  .meganav-tabbed__link-item-icon {
    width: {{ section.settings.meganav_icon_size | default: 40 }}px !important;
    height: {{ section.settings.meganav_icon_size | default: 40 }}px !important;
    min-width: {{ section.settings.meganav_icon_size | default: 40 }}px !important;
  }

  /* Mega Menu Links Grid Icon Size - Adjustable from Admin */
  .meganav-tabbed__links-grid.meganav-tabbed__links-grid--with-icons .meganav-tabbed__link-item .meganav-tabbed__link-item-icon,
  .meganav-tabbed__links-grid.meganav-tabbed__links-grid--with-icons .meganav-tabbed__link-item .meganav-tabbed__submenu-icon {
    width: {{ section.settings.meganav_link_icon_size | default: 30 }}px !important;
    height: {{ section.settings.meganav_link_icon_size | default: 30 }}px !important;
    min-width: {{ section.settings.meganav_link_icon_size | default: 30 }}px !important;
  }

  .meganav-tabbed__links-grid.meganav-tabbed__links-grid--with-icons .meganav-tabbed__link-item {
    padding-left: calc({{ section.settings.meganav_link_icon_size | default: 30 }}px + 10px) !important;
  }

  /* ========================================
     VALENTINE'S SPECIAL - Super Attractive Link
     ======================================== */

  /* Target Valentine's Special menu item */
  .site-navigation a[href*="valentine" i],
  .site-navigation a[href*="valentines" i] {
    position: relative !important;
    background: linear-gradient(
      -45deg,
      #ff6b9d 0%,
      #ff1744 25%,
      #ff4081 50%,
      #ff1744 75%,
      #ff6b9d 100%
    ) !important;
    background-size: 400% 400% !important;
    color: #ffffff !important;
    padding: 8px 18px !important;
    border-radius: 20px !important;
    font-weight: 700 !important;
    font-size: inherit !important;
    text-transform: inherit !important;
    letter-spacing: inherit !important;
    animation: valentine-gradient-wave 6s ease-in-out infinite !important;
    transition: all 0.3s ease !important;
    overflow: visible !important;
    z-index: 999 !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
  }

  /* Smooth wave-like gradient animation */
  @keyframes valentine-gradient-wave {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  /* Hover effect - glowing border */
  .site-navigation a[href*="valentine" i]:hover,
  .site-navigation a[href*="valentines" i]:hover {
    border: 2px solid rgba(255, 255, 255, 0.9) !important;
    box-shadow: 0 0 20px rgba(255, 23, 68, 0.7),
                0 0 30px rgba(255, 107, 157, 0.5),
                inset 0 0 15px rgba(255, 255, 255, 0.15) !important;
    transform: translateY(-2px) scale(1.02) !important;
  }

  /* Shimmer overlay effect */
  .site-navigation a[href*="valentine" i]::before,
  .site-navigation a[href*="valentines" i]::before {
    content: "" !important;
    position: absolute !important;
    top: -2px !important;
    left: -100% !important;
    width: 50% !important;
    height: calc(100% + 4px) !important;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    ) !important;
    animation: shimmer-sweep 2.5s ease-in-out infinite !important;
    border-radius: 20px !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  @keyframes shimmer-sweep {
    0% {
      left: -100%;
    }
    100% {
      left: 200%;
    }
  }

  /* Override default menu item styles for Valentine's link */
  .site-header li.navmenu-item:has(a[href*="valentine" i]):after,
  .site-header li.navmenu-item:has(a[href*="valentines" i]):after {
    display: none !important;
  }

  .site-header li.navmenu-item:has(a[href*="valentine" i]),
  .site-header li.navmenu-item:has(a[href*="valentines" i]) {
    margin: 0 8px !important;
    position: relative !important;
  }

  /* Mobile styles */
  @media screen and (max-width: 1023px) {
    .site-navigation a[href*="valentine" i],
    .site-navigation a[href*="valentines" i] {
      display: inline-block !important;
      margin: 10px auto !important;
      text-align: center !important;
    }
  }

{%- endstyle -%}

<header class="site-header site-header-nav--open" role="banner" data-site-header data-nav-header-sticky>

  <div class="site-navigation-wrapper{% if shop.customer_accounts_enabled %} site-navigation--has-actions{% endif %}{% if section.settings.full_width_header %} site-header--full-width{% endif %}" data-site-navigation id="site-header-nav">
    <nav class="site-navigation" aria-label="{{ 'general.accessibility.nav_main' | t }}">
      {%
        render 'navmenu',
        menu: section.settings.menu,
        blocks: section.blocks,
      %}

      {% if section.settings.secondary_menu != blank %}
        {%
          render 'navlist',
          menu_list: linklists[section.settings.secondary_menu].links,
          depth: 1,
          max_depth: 1,
          aria_expanded: true,
          navmenu_classes: 'site-navigation__secondary-menu',
        %}
      {% endif %}
    </nav>
  </div>

  {%- render 'site-mobile-nav', blocks: section.blocks, -%}
  <search-modal class="auto-search-modal">
      <div class="modal-1" aria-label="modal window">
          <div class="modal-inner" data-search-modal-inner>
              <div class="modal-content" data-search-modal-content>
                <div class="modal-content__wrapper">
                  <div class="live-search-form__wrapper">
                    {%-
                        render 'live-search-form',
                        quick_links: linklists[section.settings.quick_links],
                        enable_images: section.settings.enable_live_search_images,
                        enable_content: section.settings.enable_live_search_articles_pages
                    -%}
                    <button
                      class="modal-close"
                      type="button"
                      aria-label="{{ 'general.accessibility.close' | t }}"
                      data-asset="search-modal-close"
                    >
                      {%- render 'icon-menu-close' -%}
                    </button>
                  </div>
                </div>
              </div>
          </div>
      </div>
  </search-modal>
</header>

<script>
  // Move mobile nav outside header to escape stacking context
  document.addEventListener('DOMContentLoaded', function() {
    var mobileNav = document.getElementById('site-mobile-nav');
    if (mobileNav && window.innerWidth <= 749) {
      document.body.appendChild(mobileNav);
    }
  });
</script>

<script>
  // Valentine's Special Link - Minimal Heart Animations
  (function() {
    const valentineLinks = document.querySelectorAll('a[href*="valentine" i], a[href*="valentines" i]');

    if (valentineLinks.length === 0) return;

    // Add CSS animation styles
    if (!document.getElementById('valentine-heart-animation')) {
      const style = document.createElement('style');
      style.id = 'valentine-heart-animation';
      style.textContent = `
        @keyframes floatHeartRight {
          0% {
            transform: translateY(0) scale(0.8);
            opacity: 0;
          }
          15% {
            opacity: 1;
          }
          100% {
            transform: translateY(-70px) scale(1);
            opacity: 0;
          }
        }

        @keyframes floatHeartHoverSmall {
          0% {
            transform: translateY(0) scale(0.5);
            opacity: 0;
          }
          20% {
            opacity: 1;
          }
          100% {
            transform: translateY(-60px) scale(0.8);
            opacity: 0;
          }
        }
      `;
      document.head.appendChild(style);
    }

    valentineLinks.forEach(link => {
      // Create heart container
      const heartContainer = document.createElement('div');
      heartContainer.style.cssText = `
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        overflow: visible;
        z-index: -1;
      `;

      link.style.position = 'relative';
      link.parentElement.insertBefore(heartContainer, link);

      let isHovering = false;

      // Create 2-3 hearts from RIGHT side only
      function createHearts() {
        const numHearts = Math.floor(Math.random() * 2) + 2; // 2-3 hearts

        for (let i = 0; i < numHearts; i++) {
          setTimeout(() => {
            const heart = document.createElement('span');
            heart.innerHTML = '❤️';

            if (isHovering) {
              // Hover: very small clear hearts from right
              heart.style.cssText = `
                position: absolute;
                font-size: 10px;
                right: ${Math.random() * 20 + 5}%;
                bottom: -5px;
                opacity: 0;
                pointer-events: none;
                animation: floatHeartHoverSmall 2.5s ease-out forwards;
                z-index: 1001;
                filter: none;
              `;
            } else {
              // Normal: small hearts from right side
              const sizes = [12, 14];
              const randomSize = sizes[Math.floor(Math.random() * sizes.length)];

              heart.style.cssText = `
                position: absolute;
                font-size: ${randomSize}px;
                right: ${Math.random() * 25 + 5}%;
                bottom: -5px;
                opacity: 0;
                pointer-events: none;
                animation: floatHeartRight 3s ease-out forwards;
                z-index: 1000;
              `;
            }

            heartContainer.appendChild(heart);

            setTimeout(() => {
              heart.remove();
            }, 3500);
          }, i * 300);
        }
      }

      // Create hearts every 2.5 seconds
      const heartInterval = setInterval(createHearts, 2500);

      // On hover - create small clear hearts
      link.addEventListener('mouseenter', () => {
        isHovering = true;
        // Create 2-3 small hearts immediately
        const numHearts = Math.floor(Math.random() * 2) + 2;
        for (let i = 0; i < numHearts; i++) {
          setTimeout(() => {
            const heart = document.createElement('span');
            heart.innerHTML = '❤️';

            heart.style.cssText = `
              position: absolute;
              font-size: 10px;
              right: ${Math.random() * 20 + 10}%;
              bottom: -5px;
              opacity: 0;
              pointer-events: none;
              animation: floatHeartHoverSmall 2s ease-out forwards;
              z-index: 1001;
              filter: none;
            `;

            heartContainer.appendChild(heart);

            setTimeout(() => {
              heart.remove();
            }, 2000);
          }, i * 200);
        }
      });

      link.addEventListener('mouseleave', () => {
        isHovering = false;
      });

      // Cleanup on page unload
      window.addEventListener('beforeunload', () => {
        clearInterval(heartInterval);
      });
    });
  })();
</script>
{% if section.settings.sticky_header %}
<style>
  header[data-nav-header-sticky].nav-is-fixed {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    z-index: 998 !important;
  }
</style>
<script>
  (function() {
    document.addEventListener('DOMContentLoaded', function() {
      if (window.innerWidth < 1024) return;

      var navHeader = document.querySelector('[data-nav-header-sticky]');
      if (!navHeader) return;

      var headerHeight = navHeader.offsetHeight;
      var rect = navHeader.getBoundingClientRect();
      var triggerPoint = rect.top + window.scrollY + headerHeight;
      var isFixed = false;
      var placeholder = null;

      function getAiHeaderHeight() {
        var aiPlaceholder = document.getElementById('header-placeholder');
        if (aiPlaceholder && aiPlaceholder.style.height !== '0px') {
          var aiSection = aiPlaceholder.nextElementSibling;
          if (aiSection && aiSection.style.position === 'fixed') {
            return aiSection.offsetHeight;
          }
        }
        return 0;
      }

      function makeFixed() {
        if (isFixed) return;
        var aiHeight = getAiHeaderHeight();
        navHeader.classList.add('nav-is-fixed');
        navHeader.style.setProperty('top', aiHeight + 'px', 'important');

        if (!placeholder) {
          placeholder = document.createElement('div');
          placeholder.id = 'nav-header-placeholder';
          navHeader.parentNode.insertBefore(placeholder, navHeader);
        }
        placeholder.style.height = headerHeight + 'px';
        isFixed = true;
      }

      function makeNormal() {
        if (!isFixed) return;
        navHeader.classList.remove('nav-is-fixed');
        navHeader.style.removeProperty('top');

        if (placeholder) {
          placeholder.style.height = '0px';
        }
        isFixed = false;
      }

      var ticking = false;
      window.addEventListener('scroll', function() {
        if (!ticking) {
          requestAnimationFrame(function() {
            if (window.innerWidth >= 1024) {
              if (window.scrollY > triggerPoint) {
                makeFixed();
                var aiHeight = getAiHeaderHeight();
                navHeader.style.setProperty('top', aiHeight + 'px', 'important');
              } else {
                makeNormal();
              }
            }
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });

      window.addEventListener('resize', function() {
        if (!isFixed) {
          headerHeight = navHeader.offsetHeight;
          var r = navHeader.getBoundingClientRect();
          triggerPoint = r.top + window.scrollY + headerHeight;
        }
        if (window.innerWidth < 1024 && isFixed) {
          makeNormal();
        }
        if (placeholder && isFixed) {
          placeholder.style.height = headerHeight + 'px';
        }
      });
    });
  })();
</script>
{% endif %}
