{% comment %}
  Valentine's Day FAQ Section
  Interactive accordion-style FAQ with Valentine's theme
{% endcomment %}

{%- liquid
  assign bg_color = section.settings.background_color
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_size = section.settings.heading_size
  assign heading_color = section.settings.heading_color
  assign question_bg = section.settings.question_background
  assign question_text_color = section.settings.question_text_color
  assign answer_bg = section.settings.answer_background
  assign answer_text_color = section.settings.answer_text_color
  assign border_color = section.settings.border_color
  assign icon_color = section.settings.icon_color
  assign hover_color = section.settings.hover_color
  assign border_radius = section.settings.border_radius
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign max_width = section.settings.max_width
  assign icon_style = section.settings.icon_style
  assign animation_style = section.settings.animation_style
  assign show_decorative_hearts = section.settings.show_decorative_hearts
-%}

<style>
  .valentine-faq-{{ section.id }} {
    background: {{ bg_color }};
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__container {
    max-width: {{ max_width }}px;
    margin: 0 auto;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__header {
    text-align: center;
    margin-bottom: 50px;
    position: relative;
    z-index: 2;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__heading {
    font-size: {{ heading_size }}px;
    color: {{ heading_color }};
    margin-bottom: 15px;
    font-weight: 700;
    {% if animation_style == 'fade_in' %}
      animation: fadeInDown 0.8s ease-out;
    {% elsif animation_style == 'slide_up' %}
      animation: slideUp 0.8s ease-out;
    {% elsif animation_style == 'bounce' %}
      animation: bounceIn 1s ease-out;
    {% endif %}
  }

  .valentine-faq-{{ section.id }} .valentine-faq__subheading {
    font-size: 18px;
    color: {{ heading_color }};
    opacity: 0.8;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__items {
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    z-index: 2;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__item {
    border: 2px solid {{ border_color }};
    border-radius: {{ border_radius }}px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: {{ question_bg }};
    {% if animation_style == 'fade_in' %}
      animation: fadeIn 0.6s ease-out backwards;
    {% elsif animation_style == 'slide_up' %}
      animation: slideUp 0.6s ease-out backwards;
    {% endif %}
  }

  {% for i in (1..20) %}
    .valentine-faq-{{ section.id }} .valentine-faq__item:nth-child({{ i }}) {
      animation-delay: {{ i | times: 0.1 }}s;
    }
  {% endfor %}

  .valentine-faq-{{ section.id }} .valentine-faq__item:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(219, 30, 55, 0.2);
    border-color: {{ hover_color }};
  }

  .valentine-faq-{{ section.id }} .valentine-faq__question {
    width: 100%;
    padding: 10px 25px;
    background: {{ question_bg }};
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    font-size: 16px;
    font-weight: 600;
    color: {{ question_text_color }};
    transition: all 0.3s ease;
    position: relative;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__question:hover {
    background: {{ hover_color }};
    color: #ffffff;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__question-text {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__icon {
    font-size: 18px;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    color: {{ icon_color }};
    flex-shrink: 0;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__item.active .valentine-faq__icon {
    transform: rotate(180deg);
  }

  .valentine-faq-{{ section.id }} .valentine-faq__answer-wrapper {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .valentine-faq-{{ section.id }} .valentine-faq__item.active .valentine-faq__answer-wrapper {
    max-height: 1000px;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__answer {
    padding: 12px 25px;
    background: {{ answer_bg }};
    color: {{ answer_text_color }};
    font-size: 15px;
    line-height: 1.6;
    border-top: 1px solid {{ border_color }};
  }

  .valentine-faq-{{ section.id }} .valentine-faq__answer p {
    margin: 0;
  }

  .valentine-faq-{{ section.id }} .valentine-faq__answer a {
    color: {{ icon_color }};
    text-decoration: underline;
  }

  /* Decorative Hearts Background */
  {% if show_decorative_hearts %}
  .valentine-faq-{{ section.id }} .decorative-hearts {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .valentine-faq-{{ section.id }} .decorative-heart {
    position: absolute;
    font-size: 30px;
    opacity: 0.1;
    animation: floatHeart 15s infinite ease-in-out;
  }

  .valentine-faq-{{ section.id }} .decorative-heart:nth-child(1) {
    left: 10%;
    top: 20%;
    animation-delay: 0s;
  }

  .valentine-faq-{{ section.id }} .decorative-heart:nth-child(2) {
    right: 15%;
    top: 40%;
    animation-delay: 2s;
    font-size: 40px;
  }

  .valentine-faq-{{ section.id }} .decorative-heart:nth-child(3) {
    left: 20%;
    bottom: 30%;
    animation-delay: 4s;
  }

  .valentine-faq-{{ section.id }} .decorative-heart:nth-child(4) {
    right: 10%;
    bottom: 20%;
    animation-delay: 6s;
    font-size: 35px;
  }

  .valentine-faq-{{ section.id }} .decorative-heart:nth-child(5) {
    left: 50%;
    top: 10%;
    animation-delay: 8s;
  }
  {% endif %}

  /* Animations */
  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes bounceIn {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
    70% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes floatHeart {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(10deg);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .valentine-faq-{{ section.id }} .valentine-faq__heading {
      font-size: {{ heading_size | divided_by: 1.5 }}px;
    }

    .valentine-faq-{{ section.id }} .valentine-faq__question {
      padding: 8px 15px;
      font-size: 15px;
      gap: 10px;
    }

    .valentine-faq-{{ section.id }} .valentine-faq__answer {
      padding: 10px 15px;
      font-size: 14px;
      line-height: 1.5;
    }

    .valentine-faq-{{ section.id }} .valentine-faq__icon {
      font-size: 18px;
    }
  }
</style>

<section class="valentine-faq-{{ section.id }}">
  {% if show_decorative_hearts %}
  <div class="decorative-hearts">
    <div class="decorative-heart">❤️</div>
    <div class="decorative-heart">💕</div>
    <div class="decorative-heart">💖</div>
    <div class="decorative-heart">💗</div>
    <div class="decorative-heart">💝</div>
  </div>
  {% endif %}

  <div class="valentine-faq__container">
    {% if heading != blank or subheading != blank %}
    <div class="valentine-faq__header">
      {% if heading != blank %}
        <h2 class="valentine-faq__heading">{{ heading }}</h2>
      {% endif %}
      {% if subheading != blank %}
        <div class="valentine-faq__subheading">{{ subheading }}</div>
      {% endif %}
    </div>
    {% endif %}

    <div class="valentine-faq__items">
      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          <div class="valentine-faq__item" data-faq-item {{ block.shopify_attributes }}>
            <button class="valentine-faq__question" type="button" aria-expanded="false">
              <span class="valentine-faq__question-text">
                {% if icon_style == 'heart' %}
                  <span style="color: {{ icon_color }};">❤️</span>
                {% elsif icon_style == 'heart_arrow' %}
                  <span style="color: {{ icon_color }};">💘</span>
                {% elsif icon_style == 'sparkle_heart' %}
                  <span style="color: {{ icon_color }};">💖</span>
                {% elsif icon_style == 'rose' %}
                  <span style="color: {{ icon_color }};">🌹</span>
                {% elsif icon_style == 'gift' %}
                  <span style="color: {{ icon_color }};">🎁</span>
                {% endif %}
                {{ block.settings.question }}
              </span>
              <span class="valentine-faq__icon">
                {% if icon_style == 'chevron' %}
                  ▼
                {% elsif icon_style == 'plus' %}
                  +
                {% elsif icon_style == 'arrow' %}
                  ↓
                {% else %}
                  ▼
                {% endif %}
              </span>
            </button>
            <div class="valentine-faq__answer-wrapper">
              <div class="valentine-faq__answer">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function() {
    const faqSection = document.querySelector('.valentine-faq-{{ section.id }}');
    if (!faqSection) return;

    const faqItems = faqSection.querySelectorAll('[data-faq-item]');

    faqItems.forEach(item => {
      const question = item.querySelector('.valentine-faq__question');

      question.addEventListener('click', () => {
        const isActive = item.classList.contains('active');

        // Close all items if close_others is enabled
        {% if section.settings.close_others %}
          faqItems.forEach(otherItem => {
            if (otherItem !== item) {
              otherItem.classList.remove('active');
              otherItem.querySelector('.valentine-faq__question').setAttribute('aria-expanded', 'false');
            }
          });
        {% endif %}

        // Toggle current item
        if (isActive) {
          item.classList.remove('active');
          question.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('active');
          question.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Optional: Auto-open first FAQ
    {% if section.settings.auto_open_first %}
      if (faqItems.length > 0) {
        faqItems[0].classList.add('active');
        faqItems[0].querySelector('.valentine-faq__question').setAttribute('aria-expanded', 'true');
      }
    {% endif %}
  })();
</script>

{% schema %}
{
  "name": "Valentine FAQ",
  "tag": "section",
  "class": "valentine-faq-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Valentine's Day FAQ"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Got questions about Valentine's gifts? We've got answers!"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#db1e37"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Maximum Width",
      "default": 900
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Design Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fef0f0"
    },
    {
      "type": "color",
      "id": "question_background",
      "label": "Question Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "question_text_color",
      "label": "Question Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "answer_background",
      "label": "Answer Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "answer_text_color",
      "label": "Answer Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ffc0cb"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover Color",
      "default": "#db1e37"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#db1e37"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Interactive Settings"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Question Icon Style",
      "options": [
        {
          "value": "heart",
          "label": "Heart ❤️"
        },
        {
          "value": "heart_arrow",
          "label": "Heart with Arrow 💘"
        },
        {
          "value": "sparkle_heart",
          "label": "Sparkle Heart 💖"
        },
        {
          "value": "rose",
          "label": "Rose 🌹"
        },
        {
          "value": "gift",
          "label": "Gift 🎁"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "heart"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation Style",
      "options": [
        {
          "value": "fade_in",
          "label": "Fade In"
        },
        {
          "value": "slide_up",
          "label": "Slide Up"
        },
        {
          "value": "bounce",
          "label": "Bounce"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "slide_up"
    },
    {
      "type": "checkbox",
      "id": "close_others",
      "label": "Close Other FAQs When Opening One",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_open_first",
      "label": "Auto Open First FAQ",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_decorative_hearts",
      "label": "Show Decorative Hearts",
      "default": true,
      "info": "Display animated hearts in the background"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer here. You can format this text and add links.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valentine FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the most popular Valentine gift?",
            "answer": "<p>While flowers and chocolates are traditional, luxury jewelry is the most popular lasting gift. In 2025, curated ear piercing stacks (sets of matching studs and hoops) and solid gold body jewelry have become top-trending gifts because they offer a more personalized and modern alternative to standard necklaces.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is a good gift for Valentine's Day for her?",
            "answer": "<p>A good gift balances sentiment with style. If she has piercings, 14k gold cartilage earrings (like Helix or Tragus studs) are excellent choices because they are something she wears 24/7. Unlike a dress that is worn once, high-quality titanium or gold piercing jewelry becomes a permanent part of her daily look.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
