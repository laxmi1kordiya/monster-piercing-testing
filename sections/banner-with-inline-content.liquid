{% comment %}
  Banner section with background image and inline heading, subheading, and CTA button
{% endcomment %}

{% style %}
  .banner-inline-{{ section.id }} {
    position: relative;
    width: 100vw;
    max-width: 100%;
    height: calc(100vw / 3);
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    justify-content: {{ section.settings.horizontal_alignment }};
    padding: 0;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .banner-inline__background-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .banner-inline__background-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  .banner-inline__overlay-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .banner-inline__content-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.content_alignment }};
    justify-content: {{ section.settings.vertical_alignment }};
    text-align: {{ section.settings.text_alignment }};
    gap: {{ section.settings.content_gap }}px;
    width: 100%;
    height: 100%;
    padding: {{ section.settings.content_padding_top }}px {{ section.settings.content_padding_right }}px {{ section.settings.content_padding_bottom }}px {{ section.settings.content_padding_left }}px;
    box-sizing: border-box;
  }

  .banner-inline__heading-{{ section.id }} {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.2;
    margin: 0;
    {% if section.settings.heading_text_transform != 'none' %}
      text-transform: {{ section.settings.heading_text_transform }};
    {% endif %}
  }

  .banner-inline__subheading-{{ section.id }} {
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: {{ section.settings.subheading_weight }};
    line-height: 1.4;
    margin: 0;
  }

  .banner-inline__button-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    border: {{ section.settings.button_border_width }}px solid #000000;
    border-radius: {{ section.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .banner-inline__button-{{ section.id }}:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
    color: {{ section.settings.button_hover_text_color }};
    border-color: #db1e37;
  }

  /* Tablet styles */
  @media screen and (max-width: 1024px) {
    .banner-inline-{{ section.id }} {
      height: calc(100vw / 3);
    }

    .banner-inline__content-{{ section.id }} {
      gap: {{ section.settings.content_gap | times: 0.8 }}px;
      padding: 25px;
    }

    .banner-inline__heading-{{ section.id }} {
      font-size: clamp(20px, 4vw, {{ section.settings.heading_size }}px);
    }

    .banner-inline__subheading-{{ section.id }} {
      font-size: clamp(14px, 2.5vw, {{ section.settings.subheading_size }}px);
    }
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .banner-inline-{{ section.id }} {
      height: auto;
      min-height: 350px;
      aspect-ratio: auto;
      margin-left: 0;
      margin-right: 0;
      width: 100%;
    }

    .banner-inline__background-{{ section.id }} img {
      object-position: {{ section.settings.image_position_mobile }};
    }

    .banner-inline__content-{{ section.id }} {
      flex-direction: column;
      align-items: {{ section.settings.mobile_text_alignment }};
      justify-content: {{ section.settings.vertical_alignment_mobile }};
      text-align: {{ section.settings.mobile_text_alignment | replace: 'flex-start', 'left' | replace: 'flex-end', 'right' | replace: 'center', 'center' }};
      gap: 16px;
      padding: 40px 20px;
    }

    .banner-inline__heading-{{ section.id }} {
      font-size: {{ section.settings.heading_size_mobile }}px;
      font-weight: 700;
      line-height: 1.3;
    }

    .banner-inline__subheading-{{ section.id }} {
      font-size: {{ section.settings.subheading_size_mobile }}px;
      line-height: 1.6;
      opacity: 0.95;
    }

    .banner-inline__button-{{ section.id }} {
      padding: {{ section.settings.button_padding_vertical_mobile }}px {{ section.settings.button_padding_horizontal_mobile }}px;
      font-size: {{ section.settings.button_font_size_mobile }}px;
      margin-top: 10px;
    }
  }
{% endstyle %}

<section class="banner-inline-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="banner-inline__background-{{ section.id }}">
    {% if section.settings.background_image != blank or section.settings.background_image_mobile != blank %}
      <picture>
        {% if section.settings.background_image_mobile != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.background_image_mobile | image_url: width: 375 }} 375w,
              {{ section.settings.background_image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.background_image_mobile | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {% endif %}
        {% assign desktop_image = section.settings.background_image | default: section.settings.background_image_mobile %}
        <img
          src="{{ desktop_image | image_url: width: 1920 }}"
          srcset="
            {{ desktop_image | image_url: width: 750 }} 750w,
            {{ desktop_image | image_url: width: 1100 }} 1100w,
            {{ desktop_image | image_url: width: 1500 }} 1500w,
            {{ desktop_image | image_url: width: 1920 }} 1920w,
            {{ desktop_image | image_url: width: 2560 }} 2560w
          "
          sizes="100vw"
          alt="{{ desktop_image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
          width="{{ desktop_image.width }}"
          height="{{ desktop_image.height }}"
          class="banner-inline__img-desktop-{{ section.id }}"
        >
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  {% if section.settings.overlay_opacity > 0 %}
    <div class="banner-inline__overlay-{{ section.id }}"></div>
  {% endif %}

  <div class="banner-inline__content-{{ section.id }}">
    {% if section.settings.heading != blank %}
      <{{ section.settings.heading_tag }} class="banner-inline__heading-{{ section.id }}">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="banner-inline__subheading-{{ section.id }}">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="banner-inline__button-{{ section.id }}"
        {% if section.settings.button_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
      >
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

