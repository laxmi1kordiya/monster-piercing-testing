{% comment %}
  Category icons for mega menu
  Maps menu item titles to appropriate icons

  @param title String - The menu item title to get icon for
{% endcomment %}

{% assign title_handle = title | downcase | strip %}

{% case title_handle %}
  {% when 'by body part' or 'body part' or 'body piercings' or 'body' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="5" r="3"/>
      <path d="M12 8v4"/>
      <path d="M8 12h8"/>
      <path d="M8 12l-2 8"/>
      <path d="M16 12l2 8"/>
      <path d="M12 12v8"/>
    </svg>

  {% when 'piercings' or 'piercing' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="6" r="3"/>
      <line x1="12" y1="9" x2="12" y2="18"/>
      <circle cx="12" cy="20" r="2"/>
    </svg>

  {% when 'jewelry' or 'jewellery' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M6 3h12l4 6-10 13L2 9z"/>
      <path d="M12 22L6 9l6-6 6 6z"/>
    </svg>

  {% when 'more' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="1"/>
      <circle cx="19" cy="12" r="1"/>
      <circle cx="5" cy="12" r="1"/>
    </svg>

  {% when 'design it' or 'design it!' or 'custom' or 'customize' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 20h9"/>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
    </svg>

  {% when 'ear' or 'ear jewellery' or 'ear piercings' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 2C8 2 5 5 5 9c0 3 1 5 3 7s3 4 3 6c0 1-1 2-2 2"/>
      <circle cx="9" cy="11" r="1.5"/>
    </svg>

  {% when 'nose' or 'nose jewellery' or 'nose piercings' or 'nose studs' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 4c-4 0-6 3-6 6 0 2 1 4 3 5.5s4 2.5 4 4.5"/>
      <circle cx="10" cy="14" r="1.5"/>
    </svg>

  {% when 'belly' or 'belly bars' or 'belly rings' or 'belly button' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <ellipse cx="12" cy="12" rx="8" ry="10"/>
      <circle cx="12" cy="10" r="2"/>
      <line x1="12" y1="12" x2="12" y2="16"/>
      <circle cx="12" cy="17" r="1"/>
    </svg>

  {% when 'barbells' or 'barbell' or 'straight barbells' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <line x1="4" y1="12" x2="20" y2="12"/>
      <circle cx="4" cy="12" r="2"/>
      <circle cx="20" cy="12" r="2"/>
    </svg>

  {% when 'gold' or 'gold jewellery' or 'gold collection' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>

  {% when 'silver' or 'silver jewellery' or 'sterling silver' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="8"/>
      <circle cx="12" cy="12" r="4"/>
    </svg>

  {% when 'titanium' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="6" y="6" width="12" height="12" rx="2"/>
      <line x1="9" y1="6" x2="9" y2="18"/>
      <line x1="15" y1="6" x2="15" y2="18"/>
    </svg>

  {% when 'hoops' or 'hoop earrings' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="8"/>
    </svg>

  {% when 'studs' or 'stud earrings' or 'flat backs' or 'flatbacks' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="10" r="4"/>
      <line x1="12" y1="14" x2="12" y2="18"/>
      <line x1="9" y1="18" x2="15" y2="18"/>
    </svg>

  {% when 'clickers' or 'segment clickers' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="6"/>
      <line x1="12" y1="6" x2="12" y2="4"/>
    </svg>

  {% when 'septum' or 'septum rings' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M8 12a4 4 0 0 0 8 0"/>
      <circle cx="9" cy="14" r="1"/>
      <circle cx="15" cy="14" r="1"/>
    </svg>

  {% when 'lip' or 'lip piercings' or 'labret' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M6 12c0-4 3-8 6-8s6 4 6 8"/>
      <circle cx="10" cy="14" r="1.5"/>
    </svg>

  {% when 'tongue' or 'tongue piercings' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M8 6c0 0 2-2 4-2s4 2 4 2c0 8-2 14-4 14s-4-6-4-14"/>
      <circle cx="12" cy="10" r="1.5"/>
    </svg>

  {% when 'aftercare' or 'care' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 2L12 6"/>
      <path d="M12 18L12 22"/>
      <path d="M4.93 4.93L7.76 7.76"/>
      <path d="M16.24 16.24L19.07 19.07"/>
      <path d="M2 12L6 12"/>
      <path d="M18 12L22 12"/>
      <circle cx="12" cy="12" r="4"/>
    </svg>

  {% when 'new arrivals' or 'new' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>

  {% when 'sale' or 'clearance' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
      <line x1="7" y1="7" x2="7.01" y2="7"/>
    </svg>

  {% when 'shop all' or 'all' or 'collections' %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="3" y="3" width="7" height="7"/>
      <rect x="14" y="3" width="7" height="7"/>
      <rect x="3" y="14" width="7" height="7"/>
      <rect x="14" y="14" width="7" height="7"/>
    </svg>

  {% else %}
    <!-- Default: Diamond/Gem icon -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M6 3h12l4 6-10 13L2 9z"/>
      <path d="M2 9h20"/>
      <path d="M12 22L6 9l6-6 6 6z"/>
    </svg>
{% endcase %}
