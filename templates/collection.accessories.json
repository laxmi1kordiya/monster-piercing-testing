        "question_JTyanW": {
          "type": "question",
          "settings": {
            "question": "What types of accessories and parts do you offer?",
            "answer": "<p>Our Accessories Collection includes a wide range of <strong>threadless and internally threaded jewellery parts</strong>, such as decorative tops, posts, and bases. You’ll find compatible pieces in <strong>titanium, steel, silver, and gold</strong>, designed to let you customise and refresh your piercings easily.</p>",
            "icon": "none"
          }
        },
        "question_XmmET9": {
          "type": "question",
          "settings": {
            "question": "What are threadless and internally threaded tops?",
            "answer": "<ul><li><strong>Threadless tops</strong> use a push-fit system where the decorative end is held securely in place by tension. They’re smooth, easy to insert, and ideal for sensitive piercings.</li><li><strong>Internally threaded tops</strong> screw into the post’s internal thread, ensuring a secure fit and smooth insertion with no exposed threads.</li></ul><p>Both<br/>options provide a professional-grade hold, giving you freedom to mix and match your jewellery with ease.</p>",
            "icon": "none"
          }
        },
        "question_jJxEqm": {
          "type": "question",
          "settings": {
            "question": "Can I mix materials between tops and bases?",
            "answer": "<p>Each material type should only be used with its corresponding base or top. For example, <strong>titanium tops are compatible only with titanium bases</strong>, <strong>gold tops with gold bases</strong>, and so on. This ensures a perfect thread or tension fit, prevents corrosion between metals, and maintains biocompatibility and visual consistency.</p>",
            "icon": "none"
          }
        },
        "question_PgamXa": {
          "type": "question",
          "settings": {
            "question": "What materials are your accessories made from?",
            "answer": "<p>All parts are made from premium-quality materials:</p><ul><li><strong>Implant-grade titanium (ASTM<br/>F136)</strong> – hypoallergenic and ideal for new piercings.</li><li><strong>Solid gold (14K)</strong> – luxurious and suitable for healed piercings.</li><li><strong>316L surgical steel</strong> – durable and corrosion-resistant.</li><li><strong>925 sterling silver</strong> – perfect for decorative use in healed piercings.</li></ul><p>Each top and base is crafted to match precisely within its own material type.</p>",
            "icon": "none"
          }
        }
